   "source": [
    "#simulated - one window: live map with hotspot boxes, tracked-only view, 3D views and data panels\n",
    "import threading\n",
    "import time\n",
    "from collections import deque\n",
    "from dataclasses import dataclass\n",
    "from itertools import takewhile\n",
    "\n",
    "import cv2 as cv\n",
    "import matplotlib\n",
    "import numpy as np\n",
    "\n",
    "\n",
    "def use_window_backend():\n",
    "    \"\"\"Notebooks default to an inline backend that closes live figures.\"\"\"\n",
    "    try:\n",
    "        shell = get_ipython()\n",
    "    except NameError:\n",
    "        return\n",
    "    for backend in (\"qt\", \"tk\"):\n",
    "        try:\n",
    "            shell.run_line_magic(\"matplotlib\", backend)\n",
    "            return\n",
    "        except Exception:\n",
    "            continue\n",
    "\n",
    "\n",
    "use_window_backend()\n",
    "import matplotlib.pyplot as plt  # noqa: E402\n",
    "from matplotlib.patches import Rectangle  # noqa: E402\n",
    "from matplotlib.widgets import Button  # noqa: E402\n",
    "\n",
    "\n",
    "FRAME_SHAPE = (384, 256, 2)\n",
    "FRAME_SIZE = int(np.prod(FRAME_SHAPE))\n",
    "\n",
    "\n",
    "@dataclass\n",
    "class Config:\n",
    "    simulate: bool = True            # True = synthetic scene, False = real TC001\n",
    "    sim_fps: float = 25.0            # simulated frame rate\n",
    "    camera_index: int = 0\n",
    "    left_crop: int = 98              # gray (fallback) mode only\n",
    "    rows: int = 80                   # time rows kept in the 3D views\n",
    "    columns: int = 64                # target number of 3D columns across the image\n",
    "    update_seconds: float = 0.08     # time between live map / data panel updates\n",
    "    full_update_seconds: float = 0.5 # time between 3D view / chart / data panel updates (slow)\n",
    "    figure_size: tuple = (18, 10)\n",
    "    blur_x: float = 0.8              # smoothing across image columns (3D views)\n",
    "    blur_t: float = 1.0              # smoothing across time rows (3D views)\n",
    "\n",
    "    # temperature scale (raw mode). Starts at temp_min/max, then follows the scene.\n",
    "    temp_min: float = 10.0\n",
    "    temp_max: float = 50.0\n",
    "    auto_scale: bool = True\n",
    "    scale_low_pct: float = 1.0\n",
    "    scale_high_pct: float = 99.8\n",
    "    min_span: float = 6.0            # never zoom the scale tighter than this many degrees\n",
    "    scale_smoothing: float = 0.08    # 0..1, lower = steadier scale\n",
    "\n",
    "    # wisps\n",
    "    ambient_pct: float = 30.0        # \"normal\" = this percentile of the recent history\n",
    "    contrast: float = 0.15           # fraction of the scale span that makes a wisp fully strong\n",
    "    min_strength: float = 0.15       # weaker cells are not drawn\n",
    "\n",
    "    # hotspot detection and tracking\n",
    "    hot_delta: float = 4.0           # a hotspot is at least this much hotter than the scene median...\n",
    "    hot_fraction: float = 0.12       # ...or this fraction of the colour scale, whichever is larger\n",
    "    prominence: float = 5.0          # a peak must rise this much above the dip joining it to a\n",
    "                                     # hotter neighbour to count as its own hotspot\n",
    "    min_area: int = 20               # pixels; smaller hot blobs are ignored\n",
    "    min_rise: float = 1.5            # a hotspot's peak must be this far above the hotspot level\n",
    "    detect_step: int = 2             # detection runs on an image this many times smaller (speed)\n",
    "    match_distance: float = 30.0     # pixels a hotspot may jump between frames and keep its ID...\n",
    "    max_speed: float = 80.0          # ...plus this many pixels per second since it was last seen\n",
    "    confirm_frames: int = 3          # frames before a new hotspot gets an ID and a box\n",
    "    forget_frames: int = 20          # frames a hotspot may be missing before it is dropped\n",
    "    focus_margin: int = 4            # pixels of surroundings kept around the picked hotspot\n",
    "    chart_seconds: float = 30.0      # length of the temperature history chart\n",
    "    log_length: int = 30000          # samples kept per hotspot (for the chart and CSV export)\n",
    "\n",
    "\n",
    "class Scale:\n",
    "    \"\"\"Colour/height range shared by the camera views, the bar and both 3D views.\"\"\"\n",
    "\n",
    "    def __init__(self, low, high, unit, auto, cfg):\n",
    "        self.low, self.high, self.unit, self.auto, self.cfg = low, high, unit, auto, cfg\n",
    "        self.primed = False\n",
    "\n",
    "    @property\n",
    "    def span(self):\n",
    "        return max(self.high - self.low, 1e-6)\n",
    "\n",
    "    @property\n",
    "    def label(self):\n",
    "        return \"°C\" if self.unit == \"C\" else self.unit\n",
    "\n",
    "    def update(self, values):\n",
    "        \"\"\"Follow the scene smoothly; rise fast so hot things never clip.\"\"\"\n",
    "        if not self.auto:\n",
    "            return\n",
    "        cfg = self.cfg\n",
    "        lo, hi = np.percentile(values[::2, ::2], (cfg.scale_low_pct, cfg.scale_high_pct))\n",
    "        hi = max(hi, lo + cfg.min_span)\n",
    "        if not self.primed:\n",
    "            self.low, self.high, self.primed = float(lo), float(hi), True\n",
    "            return\n",
    "        self.low += cfg.scale_smoothing * (lo - self.low)\n",
    "        self.high += (0.5 if hi > self.high else cfg.scale_smoothing) * (hi - self.high)\n",
    "\n",
    "\n",
    "def decode_temps(frame):\n",
    "    \"\"\"Return a 192x256 array in °C from a raw TC001 frame.\"\"\"\n",
    "    data = frame.reshape(FRAME_SHAPE)[FRAME_SHAPE[0] // 2:]\n",
    "    raw = data[..., 0].astype(np.uint16) + data[..., 1].astype(np.uint16) * 256\n",
    "    return (raw / 64.0 - 273.15).astype(np.float32)\n",
    "\n",
    "\n",
    "def decode_gray(frame, crop):\n",
    "    \"\"\"Return the cropped brightness image (0 to 255) from a normal colour frame.\"\"\"\n",
    "    return cv.cvtColor(frame[:, crop:], cv.COLOR_BGR2GRAY).astype(np.float32)\n",
    "\n",
    "\n",
    "def open_raw(index):\n",
    "    \"\"\"Return a capture that delivers raw TC001 frames, or None if it doesn't.\"\"\"\n",
    "    for name, backend in ((\"DSHOW\", cv.CAP_DSHOW), (\"MSMF\", cv.CAP_MSMF), (\"default\", cv.CAP_ANY)):\n",
    "        capture = cv.VideoCapture(index, backend)\n",
    "        if not capture.isOpened():\n",
    "            capture.release()\n",
    "            continue\n",
    "        capture.set(cv.CAP_PROP_CONVERT_RGB, 0)\n",
    "        ok, frame = capture.read()\n",
    "        print(f\"[{name}] read ok={ok}, shape={getattr(frame, 'shape', None)}, \"\n",
    "              f\"size={getattr(frame, 'size', None)} (need {FRAME_SIZE})\")\n",
    "        if ok and frame.size == FRAME_SIZE:\n",
    "            return capture\n",
    "        capture.release()\n",
    "    return None\n",
    "\n",
    "\n",
    "class Camera:\n",
    "    \"\"\"Reads frames on a background thread so the display never works from stale, queued frames.\"\"\"\n",
    "\n",
    "    def __init__(self, cfg):\n",
    "        self.crop = cfg.left_crop\n",
    "        self.capture = open_raw(cfg.camera_index)\n",
    "        self.raw = self.capture is not None\n",
    "        if not self.raw:\n",
    "            self.capture = cv.VideoCapture(cfg.camera_index)\n",
    "        if not self.capture.isOpened():\n",
    "            raise RuntimeError(\"Could not open camera. Try another camera_index.\")\n",
    "        if self.raw:\n",
    "            self.scale = Scale(cfg.temp_min, cfg.temp_max, \"C\", cfg.auto_scale, cfg)\n",
    "        else:\n",
    "            self.scale = Scale(0, 255, \"signal\", False, cfg)\n",
    "\n",
    "        self._frame = None\n",
    "        self._lock = threading.Lock()\n",
    "        self._ready = threading.Event()\n",
    "        self._stop = threading.Event()\n",
    "        self._thread = threading.Thread(target=self._grab, daemon=True)\n",
    "        self._thread.start()\n",
    "\n",
    "    def _grab(self):\n",
    "        while not self._stop.is_set():\n",
    "            ok, frame = self.capture.read()\n",
    "            with self._lock:\n",
    "                self._frame = frame if ok else None\n",
    "            self._ready.set()\n",
    "            if not ok:\n",
    "                break\n",
    "\n",
    "    def read(self):\n",
    "        \"\"\"Return the newest temperatures in °C (raw mode) or brightness, or None.\"\"\"\n",
    "        if not self._ready.wait(2.0):\n",
    "            return None\n",
    "        self._ready.clear()\n",
    "        with self._lock:\n",
    "            frame = self._frame\n",
    "        if frame is None:\n",
    "            return None\n",
    "        return decode_temps(frame) if self.raw else decode_gray(frame, self.crop)\n",
    "\n",
    "    def release(self):\n",
    "        self._stop.set()\n",
    "        self._thread.join(timeout=2.0)\n",
    "        self.capture.release()\n",
    "\n",
    "\n",
    "class SimulatedCamera:\n",
    "    \"\"\"Drop-in stand-in for Camera: same attributes and methods, synthetic 192x256 °C frames.\n",
    "\n",
    "    Scene: a cool room with a warm right-hand wall and slow drifting texture, a person\n",
    "    (body + head) walking side to side, a pulsing hot spot (like a soldering iron or mug),\n",
    "    and a warm hand that sweeps across now and then. Plus a little sensor noise.\n",
    "    \"\"\"\n",
    "\n",
    "    H, W = 192, 256\n",
    "\n",
    "    def __init__(self, cfg):\n",
    "        self.raw = True\n",
    "        self.crop = cfg.left_crop\n",
    "        self.scale = Scale(cfg.temp_min, cfg.temp_max, \"C\", cfg.auto_scale, cfg)\n",
    "        self.period = 1.0 / cfg.sim_fps\n",
    "        self.rng = np.random.default_rng(1)\n",
    "        self.gx = np.arange(self.W, dtype=np.float32)\n",
    "        self.gy = np.arange(self.H, dtype=np.float32)\n",
    "\n",
    "        # Static, smooth room texture (about +/-1 degree) and a warm wall on the right.\n",
    "        coarse = self.rng.normal(size=(12, 16)).astype(np.float32)\n",
    "        texture = cv.resize(coarse, (self.W, self.H), interpolation=cv.INTER_CUBIC)\n",
    "        wall = 3.0 * np.clip((self.gx - 150) / 106, 0, 1) ** 2\n",
    "        self.room = 21.0 + 1.0 * texture + wall[None, :]\n",
    "\n",
    "        self.t0 = time.monotonic()\n",
    "        self.next_frame = self.t0\n",
    "\n",
    "    def _blob(self, cx, cy, sx, sy, amp):\n",
    "        bx = np.exp(-((self.gx - cx) ** 2) / (2 * sx * sx))\n",
    "        by = np.exp(-((self.gy - cy) ** 2) / (2 * sy * sy))\n",
    "        return amp * by[:, None] * bx[None, :]\n",
    "\n",
    "    def read(self):\n",
    "        \"\"\"Block until the next frame is due, then return it (°C).\"\"\"\n",
    "        now = time.monotonic()\n",
    "        if now < self.next_frame:\n",
    "            time.sleep(self.next_frame - now)\n",
    "        self.next_frame = max(self.next_frame + self.period, time.monotonic() - self.period)\n",
    "        t = time.monotonic() - self.t0\n",
    "\n",
    "        frame = self.room.copy()\n",
    "\n",
    "        # Person walking back and forth, with a bit of bobbing.\n",
    "        px = self.W / 2 + 70 * np.sin(0.35 * t)\n",
    "        py = self.H * 0.62 + 6 * np.sin(1.1 * t)\n",
    "        frame += self._blob(px, py, 22, 48, 11.0)                 # torso\n",
    "        frame += self._blob(px, py - 58, 10, 12, 13.0)            # head\n",
    "\n",
    "        # Pulsing hot spot, just beyond where the person turns around.\n",
    "        frame += self._blob(238, 150, 5, 5, 24 + 8 * np.sin(1.7 * t))\n",
    "\n",
    "        # A warm hand sweeping across the top every ~9 s.\n",
    "        phase = (t % 9.0) / 9.0\n",
    "        frame += self._blob(-20 + phase * (self.W + 40), 50, 8, 8, 14 * np.sin(np.pi * phase))\n",
    "\n",
    "        frame += self.rng.normal(0, 0.08, frame.shape)\n",
    "        return frame.astype(np.float32)\n",
    "\n",
    "    def release(self):\n",
    "        pass\n",
    "\n",
    "\n",
    "def make_camera(cfg):\n",
    "    return SimulatedCamera(cfg) if cfg.simulate else Camera(cfg)\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------------------------------------\n",
    "# Hotspot detection and tracking\n",
    "# ----------------------------------------------------------------------------------------------\n",
    "\n",
    "@dataclass\n",
    "class Detection:\n",
    "    box: tuple          # x, y, w, h in image pixels\n",
    "    center: tuple       # heat-weighted centre (x, y)\n",
    "    peak: float         # hottest reading inside the hotspot\n",
    "    peak_xy: tuple      # where that reading is\n",
    "    mean: float         # average reading over the hotspot\n",
    "    area: int           # pixels\n",
    "    mask: np.ndarray    # bool image, True inside the hotspot\n",
    "\n",
    "\n",
    "def segment_peaks(img, threshold, prominence):\n",
    "    \"\"\"Label the pixels above threshold, one label per peak that clearly stands on its own.\n",
    "\n",
    "    Pixels are visited hottest first. Each one joins the region of a neighbour it touches.\n",
    "    When two regions meet, the cooler one is folded into the hotter one unless its peak rises\n",
    "    at least `prominence` above the meeting point. So a head on a body stays one hotspot,\n",
    "    while a person standing next to a hot mug gives two.\n",
    "    \"\"\"\n",
    "    h, w = img.shape\n",
    "    pw = w + 2\n",
    "    padded = np.full((h + 2, pw), -np.inf, np.float32)\n",
    "    padded[1:-1, 1:-1] = img\n",
    "    flat = padded.ravel()\n",
    "    idx = np.flatnonzero(flat > threshold)\n",
    "    if idx.size == 0:\n",
    "        return np.zeros((h, w), np.int32)\n",
    "\n",
    "    order = idx[np.argsort(-flat[idx], kind=\"stable\")]\n",
    "    offsets = (-pw - 1, -pw, -pw + 1, -1, 1, pw - 1, pw, pw + 1)\n",
    "    owner, parent, peak = {}, [], []\n",
    "\n",
    "    def find(c):\n",
    "        while parent[c] != c:\n",
    "            parent[c] = parent[parent[c]]\n",
    "            c = parent[c]\n",
    "        return c\n",
    "\n",
    "    for p, v in zip(order.tolist(), flat[order].tolist()):\n",
    "        roots = []\n",
    "        for o in offsets:\n",
    "            c = owner.get(p + o)\n",
    "            if c is not None:\n",
    "                r = find(c)\n",
    "                if r not in roots:\n",
    "                    roots.append(r)\n",
    "        if not roots:\n",
    "            owner[p] = len(parent)\n",
    "            parent.append(len(parent))\n",
    "            peak.append(v)\n",
    "            continue\n",
    "        if len(roots) > 1:\n",
    "            roots.sort(key=peak.__getitem__, reverse=True)\n",
    "            for r in roots[1:]:\n",
    "                if peak[r] - v < prominence:\n",
    "                    parent[r] = roots[0]\n",
    "        owner[p] = roots[0]\n",
    "\n",
    "    names = {}\n",
    "    pixels = np.fromiter(owner.keys(), np.int64, len(owner))\n",
    "    labels = np.fromiter((names.setdefault(find(c), len(names) + 1) for c in owner.values()),\n",
    "                         np.int32, len(owner))\n",
    "    out = np.zeros(flat.size, np.int32)\n",
    "    out[pixels] = labels\n",
    "    return out.reshape(h + 2, pw)[1:-1, 1:-1].copy()\n",
    "\n",
    "\n",
    "class HotspotDetector:\n",
    "    \"\"\"Finds the regions clearly hotter than the scene and measures each one.\"\"\"\n",
    "\n",
    "    def __init__(self, cfg):\n",
    "        self.cfg = cfg\n",
    "        self.ambient = None       # scene median, smoothed\n",
    "        self.threshold = None     # current \"hotspot\" level\n",
    "\n",
    "    def detect(self, values, scale):\n",
    "        cfg = self.cfg\n",
    "        blurred = cv.GaussianBlur(values, (0, 0), 1.2)\n",
    "        target = float(np.median(blurred[::2, ::2]))\n",
    "        self.ambient = target if self.ambient is None else self.ambient + 0.1 * (target - self.ambient)\n",
    "        self.threshold = self.ambient + max(cfg.hot_delta, cfg.hot_fraction * scale.span)\n",
    "        prominence = max(cfg.prominence, 0.08 * scale.span)\n",
    "\n",
    "        h, w = values.shape\n",
    "        f = max(1, int(cfg.detect_step))\n",
    "        small = cv.resize(blurred, (w // f, h // f), interpolation=cv.INTER_AREA) if f > 1 else blurred\n",
    "        small_labels = segment_peaks(small, self.threshold, prominence)\n",
    "        up = np.repeat(np.repeat(small_labels, f, axis=0), f, axis=1)\n",
    "        labels = np.zeros((h, w), np.int32)\n",
    "        labels[:up.shape[0], :up.shape[1]] = up\n",
    "        labels[blurred <= self.threshold] = 0\n",
    "\n",
    "        found = []\n",
    "        for label in range(1, int(small_labels.max()) + 1):\n",
    "            mask = labels == label\n",
    "            ys, xs = np.nonzero(mask)\n",
    "            if xs.size < cfg.min_area:\n",
    "                continue\n",
    "            weight = np.clip(blurred[ys, xs] - self.ambient, 1e-3, None)\n",
    "            if blurred[ys, xs].max() < self.threshold + cfg.min_rise:\n",
    "                continue                      # barely warm: texture or the edge of something\n",
    "            readings = values[ys, xs]\n",
    "            k = int(np.argmax(readings))\n",
    "            x0, y0 = int(xs.min()), int(ys.min())\n",
    "            found.append(Detection(\n",
    "                box=(x0, y0, int(xs.max()) - x0 + 1, int(ys.max()) - y0 + 1),\n",
    "                center=(float((xs * weight).sum() / weight.sum()),\n",
    "                        float((ys * weight).sum() / weight.sum())),\n",
    "                peak=float(readings[k]),\n",
    "                peak_xy=(int(xs[k]), int(ys[k])),\n",
    "                mean=float(readings.mean()),\n",
    "                area=int(xs.size),\n",
    "                mask=mask,\n",
    "            ))\n",
    "        return found\n",
    "\n",
    "\n",
    "class Track:\n",
    "    \"\"\"One hotspot followed over time, with everything recorded about it.\"\"\"\n",
    "\n",
    "    def __init__(self, det, now, cfg):\n",
    "        self.id = None                    # given once the hotspot is confirmed\n",
    "        self.det = det\n",
    "        self.center = self.start = self.pos = det.center   # smoothed centre / start / raw centre\n",
    "        self.vel = (0.0, 0.0)                              # px per second, smoothed\n",
    "        self.first_seen = self.last_seen = now\n",
    "        self.hits, self.missed = 0, 0\n",
    "        self.distance = 0.0\n",
    "        self.high, self.low, self.total = -np.inf, np.inf, 0.0\n",
    "        self.log = deque(maxlen=cfg.log_length)   # (t, peak, mean, cx, cy, bx, by, bw, bh)\n",
    "        self.see(det, now)\n",
    "\n",
    "    def see(self, det, now):\n",
    "        if self.hits:\n",
    "            dt = now - self.last_seen\n",
    "            if dt > 0:\n",
    "                vx = (det.center[0] - self.pos[0]) / dt\n",
    "                vy = (det.center[1] - self.pos[1]) / dt\n",
    "                self.vel = (self.vel[0] + 0.4 * (vx - self.vel[0]), self.vel[1] + 0.4 * (vy - self.vel[1]))\n",
    "            self.pos = det.center\n",
    "            cx, cy = self.center\n",
    "            nx, ny = cx + 0.5 * (det.center[0] - cx), cy + 0.5 * (det.center[1] - cy)   # smoothed\n",
    "            self.distance += float(np.hypot(nx - cx, ny - cy))\n",
    "            self.center = (nx, ny)\n",
    "        self.det, self.last_seen = det, now\n",
    "        self.hits += 1\n",
    "        self.missed = 0\n",
    "        self.high, self.low = max(self.high, det.peak), min(self.low, det.peak)\n",
    "        self.total += det.peak\n",
    "        self.log.append((now, det.peak, det.mean, *self.center, *det.box))\n",
    "\n",
    "    def predict(self, now):\n",
    "        \"\"\"Where the hotspot should be now, from its last position and velocity.\"\"\"\n",
    "        dt = min(now - self.last_seen, 1.0)\n",
    "        return self.pos[0] + self.vel[0] * dt, self.pos[1] + self.vel[1] * dt\n",
    "\n",
    "    @property\n",
    "    def average(self):\n",
    "        return self.total / max(self.hits, 1)\n",
    "\n",
    "    def speed(self, window=1.0):\n",
    "        \"\"\"Pixels per second over the last `window` seconds of sightings.\"\"\"\n",
    "        if len(self.log) < 2:\n",
    "            return 0.0\n",
    "        last = self.log[-1]\n",
    "        old = last\n",
    "        for entry in reversed(self.log):\n",
    "            old = entry\n",
    "            if entry[0] <= last[0] - window:\n",
    "                break\n",
    "        dt = last[0] - old[0]\n",
    "        return float(np.hypot(last[3] - old[3], last[4] - old[4]) / dt) if dt > 0 else 0.0\n",
    "\n",
    "    def recent(self, since):\n",
    "        \"\"\"Log entries newer than `since`, oldest first.\"\"\"\n",
    "        return list(takewhile(lambda e: e[0] >= since, reversed(self.log)))[::-1]\n",
    "\n",
    "\n",
    "class Tracker:\n",
    "    \"\"\"Keeps hotspot IDs stable from frame to frame by matching nearest centres.\"\"\"\n",
    "\n",
    "    def __init__(self, cfg):\n",
    "        self.cfg = cfg\n",
    "        self.tracks = []\n",
    "        self.next_id = 1\n",
    "\n",
    "    def update(self, detections, now, keep=None):\n",
    "        cfg = self.cfg\n",
    "        pairs = []\n",
    "        for i, t in enumerate(self.tracks):\n",
    "            px, py = t.predict(now)\n",
    "            reach = cfg.match_distance + cfg.max_speed * min(now - t.last_seen, 0.75)\n",
    "            for j, d in enumerate(detections):\n",
    "                dist = float(np.hypot(px - d.center[0], py - d.center[1]))\n",
    "                if dist <= reach:\n",
    "                    pairs.append((dist, i, j))\n",
    "        pairs.sort()\n",
    "        used_t, used_d = set(), set()\n",
    "        for _, i, j in pairs:\n",
    "            if i in used_t or j in used_d:\n",
    "                continue\n",
    "            used_t.add(i)\n",
    "            used_d.add(j)\n",
    "            self.tracks[i].see(detections[j], now)\n",
    "\n",
    "        survivors = []\n",
    "        for i, t in enumerate(self.tracks):\n",
    "            if i not in used_t:\n",
    "                t.missed += 1\n",
    "                limit = cfg.forget_frames if t.id is not None else 1\n",
    "                if t.missed > limit and (keep is None or t.id != keep):\n",
    "                    continue\n",
    "            if t.id is None and t.hits >= cfg.confirm_frames:\n",
    "                t.id = self.next_id\n",
    "                self.next_id += 1\n",
    "            survivors.append(t)\n",
    "        survivors += [Track(d, now, cfg) for j, d in enumerate(detections) if j not in used_d]\n",
    "        self.tracks = survivors\n",
    "\n",
    "    def get(self, tid):\n",
    "        if tid is None:\n",
    "            return None\n",
    "        return next((t for t in self.tracks if t.id == tid), None)\n",
    "\n",
    "    def listed(self):\n",
    "        \"\"\"Confirmed hotspots, by ID.\"\"\"\n",
    "        return sorted((t for t in self.tracks if t.id is not None), key=lambda t: t.id)\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------------------------------------\n",
    "# 3D views\n",
    "# ----------------------------------------------------------------------------------------------\n",
    "\n",
    "class History:\n",
    "    \"\"\"Rolling rows: hottest value in each block of image columns, averaged over each time step.\"\"\"\n",
    "\n",
    "    def __init__(self, width, cfg):\n",
    "        self.step = max(1, width // cfg.columns)\n",
    "        self.n = width // self.step\n",
    "        self.x = np.arange(self.n) * self.step + self.step / 2\n",
    "        self.rows = deque(maxlen=cfg.rows)\n",
    "        self.reset()\n",
    "\n",
    "    def reset(self):\n",
    "        self.rows.clear()\n",
    "        self.total = np.zeros(self.n, np.float32)\n",
    "        self.count = 0\n",
    "\n",
    "    def add_frame(self, values):\n",
    "        blurred = cv.GaussianBlur(values, (0, 0), 1.0)        # suppress single hot pixels\n",
    "        h = blurred.shape[0]\n",
    "        blocks = blurred[:, :self.n * self.step].reshape(h, self.n, self.step)\n",
    "        self.total += blocks.max(axis=(0, 2))                  # hottest pixel per column block\n",
    "        self.count += 1\n",
    "\n",
    "    def commit(self):\n",
    "        if self.count == 0:\n",
    "            return\n",
    "        row = self.total / self.count\n",
    "        if not self.rows:\n",
    "            self.rows.extend([row] * self.rows.maxlen)\n",
    "        else:\n",
    "            self.rows.append(row)\n",
    "        self.total = np.zeros(self.n, np.float32)\n",
    "        self.count = 0\n",
    "\n",
    "    def as_array(self):\n",
    "        return np.array(self.rows, np.float32)\n",
    "\n",
    "\n",
    "BG, PANEL, EDGE = \"#0c0e13\", \"#151821\", \"#2b303b\"\n",
    "TEXT, MUTED = \"#e3e6ec\", \"#8b92a3\"\n",
    "SPOT_COLORS = (\"#38d1ff\", \"#7dff6a\", \"#ff6bd6\", \"#f4f4f4\", \"#b69bff\", \"#00f5c4\", \"#6ba4ff\", \"#d4ff3a\")\n",
    "\n",
    "\n",
    "def spot_color(tid):\n",
    "    return SPOT_COLORS[(tid - 1) % len(SPOT_COLORS)]\n",
    "\n",
    "\n",
    "def style_dark_axes(ax, xlim, ylim, zlabel):\n",
    "    ax.set_facecolor(BG)\n",
    "    for axis in (ax.xaxis, ax.yaxis, ax.zaxis):\n",
    "        axis.set_pane_color((0, 0, 0, 0))\n",
    "    ax.set_xlim(*xlim)\n",
    "    ax.set_ylim(*ylim)\n",
    "    ax.set_xlabel(\"Image X\", color=\"0.7\")\n",
    "    ax.set_ylabel(\"Time\", color=\"0.7\")\n",
    "    ax.set_zlabel(zlabel, color=\"0.7\")\n",
    "    ax.tick_params(colors=\"0.6\")\n",
    "    ax.view_init(45, -70)\n",
    "\n",
    "\n",
    "class SurfacePanel:\n",
    "    \"\"\"Surface of the hottest value per column over time, in real units.\"\"\"\n",
    "\n",
    "    def __init__(self, ax, history, cfg, scale):\n",
    "        self.ax, self.scale, self.surf = ax, scale, None\n",
    "        self.x, self.y = np.meshgrid(history.x, np.arange(cfg.rows))\n",
    "        style_dark_axes(ax, (0, history.x.max()), (0, cfg.rows - 1), f\"Signal ({scale.label})\")\n",
    "\n",
    "    def draw(self, grid):\n",
    "        s = self.scale\n",
    "        if self.surf is not None:\n",
    "            self.surf.remove()\n",
    "        self.surf = self.ax.plot_surface(\n",
    "            self.x, self.y, np.clip(grid, s.low, s.high),\n",
    "            cmap=\"inferno\", vmin=s.low, vmax=s.high,\n",
    "            linewidth=0, antialiased=False, shade=False,\n",
    "            rcount=grid.shape[0], ccount=grid.shape[1],\n",
    "        )\n",
    "        self.ax.set_zlim(s.low, s.high)\n",
    "\n",
    "\n",
    "class WispPanel:\n",
    "    \"\"\"Particles for everything hotter than the scene's normal level.\"\"\"\n",
    "\n",
    "    PARTICLES = 2\n",
    "\n",
    "    def __init__(self, ax, history, cfg, scale):\n",
    "        self.ax, self.cfg, self.scale, self.history = ax, cfg, scale, history\n",
    "        self.x, self.y = np.meshgrid(history.x, np.arange(cfg.rows))\n",
    "        rng = np.random.default_rng(7)\n",
    "        self.jitter = rng.uniform(-0.5, 0.5, (self.PARTICLES, 3, self.x.size))   # fixed, so no flicker\n",
    "        self.fade = np.linspace(0.15, 1.0, cfg.rows)[:, None]\n",
    "        self.ambient = None\n",
    "        self.top = None\n",
    "        style_dark_axes(ax, (0, history.x.max()), (0, cfg.rows - 1), f\"{scale.label} above normal\")\n",
    "        self.cloud = ax.scatter([0], [0], [0], s=1, c=[(0, 0, 0, 0)], depthshade=False, linewidths=0)\n",
    "\n",
    "    def draw(self, grid):\n",
    "        s, cfg = self.scale, self.cfg\n",
    "        target = float(np.percentile(grid, cfg.ambient_pct))\n",
    "        self.ambient = target if self.ambient is None else self.ambient + 0.05 * (target - self.ambient)\n",
    "\n",
    "        contrast = max(cfg.contrast * s.span, 1e-6)\n",
    "        excess = np.clip(grid - self.ambient, 0, None)\n",
    "        strength = np.clip(excess / contrast, 0, 1) * self.fade\n",
    "        cells = np.flatnonzero(strength.ravel() > cfg.min_strength)\n",
    "\n",
    "        target_top = max(4 * contrast, float(excess.max()) * 1.1)\n",
    "        self.top = target_top if self.top is None else self.top + 0.2 * (target_top - self.top)\n",
    "        self.ax.set_zlim(0, self.top)\n",
    "\n",
    "        if not cells.size:\n",
    "            self.cloud._offsets3d = ([0.0], [0.0], [0.0])\n",
    "            self.cloud.set_facecolor([(0, 0, 0, 0)])\n",
    "            self.cloud.set_sizes([1])\n",
    "            return\n",
    "\n",
    "        heat = excess.ravel()[cells]\n",
    "        power = strength.ravel()[cells]\n",
    "        jit = self.jitter[:, :, cells]                                        # (P, 3, n)\n",
    "        px = (self.x.ravel()[cells] + jit[:, 0] * self.history.step).ravel()\n",
    "        py = (self.y.ravel()[cells] + jit[:, 1]).ravel()\n",
    "        pz = np.clip(heat + jit[:, 2] * contrast * 0.15, 0, None).ravel()\n",
    "        power = np.tile(power, self.PARTICLES)\n",
    "        temp = self.ambient + np.tile(heat, self.PARTICLES)                    # absolute value -> same colour bar\n",
    "\n",
    "        colors = plt.get_cmap(\"inferno\")(np.clip((temp - s.low) / s.span, 0, 1))\n",
    "        colors[:, 3] = np.clip(power * 1.2, 0, 1)\n",
    "        self.cloud._offsets3d = (px, py, pz)\n",
    "        self.cloud.set_facecolor(colors)\n",
    "        self.cloud.set_sizes(4 + 34 * power)\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------------------------------------\n",
    "# The one window\n",
    "# ----------------------------------------------------------------------------------------------\n",
    "\n",
    "def style_panel(ax):\n",
    "    ax.set_facecolor(PANEL)\n",
    "    ax.set_xticks([])\n",
    "    ax.set_yticks([])\n",
    "    ax.set_xlim(0, 1)\n",
    "    ax.set_ylim(0, 1)\n",
    "    for spine in ax.spines.values():\n",
    "        spine.set_color(EDGE)\n",
    "\n",
    "\n",
    "class ThermalApp:\n",
    "    \"\"\"Live map with every hotspot boxed, a tracked-only view, both 3D views and data panels.\n",
    "\n",
    "    Pick a hotspot by clicking its box on the live map or its row in the list. The live map\n",
    "    keeps showing everything; the tracked view, the 3D views, the data and the chart then\n",
    "    follow only the picked hotspot.\n",
    "    \"\"\"\n",
    "\n",
    "    ROWS, ROW_TOP, ROW_GAP = 8, 0.80, 0.095\n",
    "\n",
    "    def __init__(self, cfg, scale, history, tracker, detector, shape, simulated):\n",
    "        plt.ion()\n",
    "        self.cfg, self.scale, self.history = cfg, scale, history\n",
    "        self.tracker, self.detector = tracker, detector\n",
    "        self.selected = None\n",
    "        self.closed = False\n",
    "        self.message, self.message_until = \"\", 0.0\n",
    "        self.row_ids, self.drawn, self.buttons = [], [], []\n",
    "        self.frames, self.fps, self.fps_t0 = 0, 0.0, time.monotonic()\n",
    "        self.soft_key, self.soft = None, None\n",
    "        m = max(0, int(cfg.focus_margin))\n",
    "        self.kernel = cv.getStructuringElement(cv.MORPH_ELLIPSE, (2 * m + 1, 2 * m + 1))\n",
    "        h, w = shape\n",
    "        self.width = w\n",
    "\n",
    "        fig = self.fig = plt.figure(\"Thermal hotspot tracker\", figsize=cfg.figure_size, facecolor=BG)\n",
    "        manager = fig.canvas.manager\n",
    "        if getattr(manager, \"key_press_handler_id\", None) is not None:\n",
    "            fig.canvas.mpl_disconnect(manager.key_press_handler_id)   # our own keys, not matplotlib's\n",
    "\n",
    "        fig.text(0.012, 0.972, \"Thermal hotspot tracker\" + (\"   ·   SIMULATION\" if simulated else \"\"),\n",
    "                 color=TEXT, fontsize=14, fontweight=\"bold\", va=\"center\")\n",
    "        fig.text(0.012, 0.944, \"Click a box (or a list row) to track one hotspot   ·   N / P  next / previous\"\n",
    "                 \"   ·   A  show all   ·   1-8  pick from list   ·   S  save CSV   ·   Q  quit\",\n",
    "                 color=MUTED, fontsize=9, va=\"center\")\n",
    "\n",
    "        # 2D views: live map (all hotspots) and tracked-only view\n",
    "        self.ax_live = fig.add_axes([0.012, 0.50, 0.325, 0.41])\n",
    "        self.ax_focus = fig.add_axes([0.35, 0.50, 0.325, 0.41])\n",
    "        blank = np.zeros(shape, np.float32)\n",
    "        self.live_img = self._image_axes(self.ax_live, blank, w, h)\n",
    "        self.focus_img = self._image_axes(self.ax_focus, blank, w, h)\n",
    "        self.live_boxes, self.focus_boxes = [], []\n",
    "        self.live_peak, = self.ax_live.plot([], [], \"+\", ms=12, mew=1.6, color=\"white\")\n",
    "        self.focus_peak, = self.ax_focus.plot([], [], \"+\", ms=12, mew=1.6, color=\"white\")\n",
    "        self.focus_note = self.ax_focus.text(0.5, 0.5, \"\", transform=self.ax_focus.transAxes, ha=\"center\",\n",
    "                                             va=\"center\", color=TEXT, fontsize=11,\n",
    "                                             bbox=dict(boxstyle=\"round,pad=0.5\", fc=BG, ec=EDGE, alpha=0.85))\n",
    "        self.focus_note.set_visible(False)\n",
    "        self.live_title = self.ax_live.text(0, 1.015, \"\", transform=self.ax_live.transAxes, color=TEXT,\n",
    "                                            fontsize=10, va=\"bottom\")\n",
    "        self.focus_title = self.ax_focus.text(0, 1.015, \"\", transform=self.ax_focus.transAxes, color=TEXT,\n",
    "                                              fontsize=10, va=\"bottom\")\n",
    "\n",
    "        cbar = fig.colorbar(self.live_img, cax=fig.add_axes([0.684, 0.52, 0.008, 0.37]))\n",
    "        cbar.ax.set_title(scale.label, color=MUTED, fontsize=9)\n",
    "        cbar.ax.tick_params(colors=MUTED, labelsize=8)\n",
    "        cbar.outline.set_edgecolor(EDGE)\n",
    "\n",
    "        # 3D views\n",
    "        left = fig.add_axes([-0.01, 0.0, 0.37, 0.48], projection=\"3d\")\n",
    "        right = fig.add_axes([0.33, 0.0, 0.37, 0.48], projection=\"3d\")\n",
    "        self.panels = [SurfacePanel(left, history, cfg, scale), WispPanel(right, history, cfg, scale)]\n",
    "\n",
    "        # hotspot list\n",
    "        self.ax_list = fig.add_axes([0.715, 0.70, 0.272, 0.225])\n",
    "        style_panel(self.ax_list)\n",
    "        self.list_title = self.ax_list.text(0.04, 0.93, \"\", color=MUTED, fontsize=9, fontweight=\"bold\", va=\"top\")\n",
    "        self.row_bg = Rectangle((0.015, 0), 0.97, self.ROW_GAP * 0.92, fc=\"#22314a\", ec=\"none\", visible=False)\n",
    "        self.ax_list.add_patch(self.row_bg)\n",
    "        self.row_swatch, self.row_text = [], []\n",
    "        for i in range(self.ROWS):\n",
    "            y = self.ROW_TOP - i * self.ROW_GAP\n",
    "            self.row_swatch.append(self.ax_list.text(0.04, y, \"■\", fontsize=11, va=\"center\"))\n",
    "            self.row_text.append(self.ax_list.text(0.10, y, \"\", family=\"monospace\", fontsize=9.5,\n",
    "                                                   color=TEXT, va=\"center\"))\n",
    "        self.list_note = self.ax_list.text(0.5, 0.45, \"\", ha=\"center\", va=\"center\", color=MUTED, fontsize=9.5)\n",
    "\n",
    "        # data panel\n",
    "        self.ax_info = fig.add_axes([0.715, 0.37, 0.272, 0.315])\n",
    "        style_panel(self.ax_info)\n",
    "        self.info_title = self.ax_info.text(0.04, 0.95, \"\", color=MUTED, fontsize=9, fontweight=\"bold\", va=\"top\")\n",
    "        self.info_keys = self.ax_info.text(0.04, 0.865, \"\", color=MUTED, fontsize=9.5, va=\"top\", linespacing=1.5)\n",
    "        self.info_vals = self.ax_info.text(0.42, 0.865, \"\", color=TEXT, fontsize=9.5, va=\"top\", linespacing=1.5)\n",
    "\n",
    "        # temperature chart\n",
    "        ax = self.ax_chart = fig.add_axes([0.752, 0.145, 0.233, 0.18])\n",
    "        ax.set_facecolor(PANEL)\n",
    "        for spine in ax.spines.values():\n",
    "            spine.set_color(EDGE)\n",
    "        ax.tick_params(colors=MUTED, labelsize=8)\n",
    "        ax.grid(color=EDGE, linewidth=0.6)\n",
    "        ax.set_xlabel(\"seconds ago\", color=MUTED, fontsize=8)\n",
    "        ax.set_ylabel(scale.label, color=MUTED, fontsize=8)\n",
    "        ax.set_xlim(-cfg.chart_seconds, 0)\n",
    "        self.chart_lines = []\n",
    "        self.mean_line, = ax.plot([], [], \"--\", lw=1, color=MUTED)\n",
    "        self.peak_line = ax.axhline(0, ls=\":\", lw=1, color=MUTED, visible=False)\n",
    "\n",
    "        # buttons and status line\n",
    "        self.message_text = fig.text(0.715, 0.093, \"\", color=\"#ffd166\", fontsize=9, va=\"center\")\n",
    "        for i, (label, action) in enumerate(((\"◀ Prev\", lambda: self.cycle(-1)),\n",
    "                                             (\"Next ▶\", lambda: self.cycle(1)),\n",
    "                                             (\"Show all\", lambda: self.select(None)),\n",
    "                                             (\"Save CSV\", self.save_csv))):\n",
    "            self._button([0.715 + i * 0.0703, 0.025, 0.062, 0.05], label, action)\n",
    "\n",
    "        fig.canvas.mpl_connect(\"button_press_event\", self._on_click)\n",
    "        fig.canvas.mpl_connect(\"key_press_event\", self._on_key)\n",
    "        fig.canvas.mpl_connect(\"close_event\", self._on_close)\n",
    "\n",
    "        # Fast parts are \"animated\": drawn on top of a saved background (blitting), so the live\n",
    "        # map stays smooth while the slow 3D views only redraw every full_update_seconds.\n",
    "        self.blit = bool(getattr(fig.canvas, \"supports_blit\", False))\n",
    "        self.background, self.last_full = None, -np.inf\n",
    "        self.fast = [self.live_img, self.focus_img, self.live_peak, self.focus_peak, self.focus_note,\n",
    "                     self.live_title, self.focus_title, self.message_text]\n",
    "        for artist in self.fast:\n",
    "            artist.set_animated(self.blit)\n",
    "        fig.canvas.mpl_connect(\"draw_event\", self._on_draw)\n",
    "        try:\n",
    "            fig.show()\n",
    "        except Exception:\n",
    "            pass\n",
    "\n",
    "    # ---- building blocks ----\n",
    "\n",
    "    def _image_axes(self, ax, blank, w, h):\n",
    "        image = ax.imshow(blank, cmap=\"inferno\", vmin=self.scale.low, vmax=self.scale.high,\n",
    "                          interpolation=\"bilinear\")\n",
    "        ax.set_xlim(-0.5, w - 0.5)\n",
    "        ax.set_ylim(h - 0.5, -0.5)\n",
    "        ax.set_autoscale_on(False)\n",
    "        ax.set_xticks([])\n",
    "        ax.set_yticks([])\n",
    "        for spine in ax.spines.values():\n",
    "            spine.set_color(EDGE)\n",
    "        return image\n",
    "\n",
    "    def _button(self, rect, label, action):\n",
    "        ax = self.fig.add_axes(rect)\n",
    "        button = Button(ax, label, color=PANEL, hovercolor=\"#232838\")\n",
    "        button.label.set_color(TEXT)\n",
    "        button.label.set_fontsize(9)\n",
    "        for spine in ax.spines.values():\n",
    "            spine.set_color(EDGE)\n",
    "        button.on_clicked(lambda _event: action())\n",
    "        self.buttons.append(button)          # widgets stop working if nothing holds them\n",
    "\n",
    "    def _box(self, ax, pool, i):\n",
    "        while len(pool) <= i:\n",
    "            rect = Rectangle((0, 0), 1, 1, fill=False, lw=1.2)\n",
    "            ax.add_patch(rect)\n",
    "            label = ax.text(0, 0, \"\", fontsize=8, fontweight=\"bold\", clip_on=True,\n",
    "                            bbox=dict(boxstyle=\"square,pad=0.15\", fc=\"black\", ec=\"none\", alpha=0.6))\n",
    "            for artist in (rect, label):\n",
    "                artist.set_animated(self.blit)\n",
    "            pool.append((rect, label))\n",
    "        return pool[i]\n",
    "\n",
    "    def _place_box(self, rect, label, t, width, style, alpha):\n",
    "        x, y, w, h = t.det.box\n",
    "        color = spot_color(t.id)\n",
    "        rect.set_bounds(x - 0.5, y - 0.5, w, h)\n",
    "        rect.set_edgecolor(color)\n",
    "        rect.set_linewidth(width)\n",
    "        rect.set_linestyle(style)\n",
    "        rect.set_alpha(alpha)\n",
    "        rect.set_visible(True)\n",
    "        above = y > 14\n",
    "        right = x > self.width - 60\n",
    "        label.set_position((x + w - 0.5 if right else x - 0.5, y - 1.5 if above else y + h + 0.5))\n",
    "        label.set_va(\"bottom\" if above else \"top\")\n",
    "        label.set_ha(\"right\" if right else \"left\")\n",
    "        label.set_text(f\"#{t.id}  {t.det.peak:.1f} {self.scale.label}\")\n",
    "        label.set_color(color)\n",
    "        label.set_alpha(alpha)\n",
    "        label.set_visible(True)\n",
    "\n",
    "    @staticmethod\n",
    "    def _hide(pool, start=0):\n",
    "        for rect, label in pool[start:]:\n",
    "            rect.set_visible(False)\n",
    "            label.set_visible(False)\n",
    "\n",
    "    # ---- selection ----\n",
    "\n",
    "    def select(self, tid):\n",
    "        if tid == self.selected:\n",
    "            return\n",
    "        self.selected = tid\n",
    "        self.history.reset()               # 3D views restart with only the picked hotspot\n",
    "        self.soft_key = None\n",
    "        self.last_full = -np.inf           # redraw the 3D views and chart right away\n",
    "        self.flash(f\"Tracking hotspot #{tid} only\" if tid is not None else \"Showing all hotspots\")\n",
    "\n",
    "    def cycle(self, step):\n",
    "        ids = [t.id for t in self.tracker.listed()]\n",
    "        if not ids:\n",
    "            self.flash(\"No hotspots to pick\")\n",
    "            return\n",
    "        if self.selected in ids:\n",
    "            self.select(ids[(ids.index(self.selected) + step) % len(ids)])\n",
    "        else:\n",
    "            self.select(ids[0] if step > 0 else ids[-1])\n",
    "\n",
    "    def flash(self, text, seconds=3.0):\n",
    "        self.message, self.message_until = text, time.monotonic() + seconds\n",
    "\n",
    "    def save_csv(self):\n",
    "        t = self.tracker.get(self.selected)\n",
    "        if t is None:\n",
    "            self.flash(\"Pick a hotspot first, then save its data\")\n",
    "            return\n",
    "        name = f\"hotspot_{t.id}_{time.strftime('%Y%m%d_%H%M%S')}.csv\"\n",
    "        data = np.array(t.log, np.float64)\n",
    "        data[:, 0] -= t.first_seen\n",
    "        np.savetxt(name, data, delimiter=\",\", fmt=\"%.3f\", comments=\"\",\n",
    "                   header=\"time_s,temp_max,temp_mean,center_x,center_y,box_x,box_y,box_w,box_h\")\n",
    "        print(f\"Saved {len(data)} samples of hotspot #{t.id} to {name}\")\n",
    "        self.flash(f\"Saved {name}\")\n",
    "\n",
    "    # ---- events ----\n",
    "\n",
    "    def _on_click(self, event):\n",
    "        if event.button != 1 or event.xdata is None:\n",
    "            return\n",
    "        toolbar = getattr(self.fig.canvas, \"toolbar\", None)\n",
    "        if toolbar is not None and getattr(toolbar, \"mode\", \"\"):\n",
    "            return                         # zoom/pan tool is active\n",
    "        if event.inaxes is self.ax_live:\n",
    "            x, y, pad = event.xdata, event.ydata, 3\n",
    "            hits = [t for t in self.drawn\n",
    "                    if t.det.box[0] - pad <= x <= t.det.box[0] + t.det.box[2] + pad\n",
    "                    and t.det.box[1] - pad <= y <= t.det.box[1] + t.det.box[3] + pad]\n",
    "            if hits:\n",
    "                self.select(min(hits, key=lambda t: t.det.area).id)\n",
    "            else:\n",
    "                self.flash(\"No hotspot there - click inside a box\")\n",
    "        elif event.inaxes is self.ax_list:\n",
    "            row = int(round((self.ROW_TOP - event.ydata) / self.ROW_GAP))\n",
    "            if 0 <= row < len(self.row_ids):\n",
    "                self.select(self.row_ids[row])\n",
    "\n",
    "    def _on_key(self, event):\n",
    "        key = (event.key or \"\").lower()\n",
    "        if key in (\"q\", \"escape\"):\n",
    "            self.closed = True\n",
    "        elif key in (\"n\", \"right\", \"down\"):\n",
    "            self.cycle(1)\n",
    "        elif key in (\"p\", \"left\", \"up\"):\n",
    "            self.cycle(-1)\n",
    "        elif key in (\"a\", \"0\"):\n",
    "            self.select(None)\n",
    "        elif key == \"s\":\n",
    "            self.save_csv()\n",
    "        elif key.isdigit() and int(key) - 1 < len(self.row_ids):\n",
    "            self.select(self.row_ids[int(key) - 1])\n",
    "\n",
    "    def _on_close(self, _event):\n",
    "        self.closed = True\n",
    "\n",
    "    def _on_draw(self, _event):\n",
    "        \"\"\"After every full draw (ours, or a window resize): save the background, add the fast parts.\"\"\"\n",
    "        if self.blit:\n",
    "            self.background = self.fig.canvas.copy_from_bbox(self.fig.bbox)\n",
    "            self._draw_fast_artists()\n",
    "\n",
    "    def _draw_fast_artists(self):\n",
    "        boxes = [a for pair in self.live_boxes + self.focus_boxes for a in pair]\n",
    "        for artist in self.fast[:2] + boxes + self.fast[2:]:\n",
    "            if artist.get_visible():\n",
    "                self.fig.draw_artist(artist)\n",
    "\n",
    "    # ---- per frame ----\n",
    "\n",
    "    def tick(self, now):\n",
    "        self.frames += 1\n",
    "        if now - self.fps_t0 >= 1.0:\n",
    "            self.fps = self.frames / (now - self.fps_t0)\n",
    "            self.frames, self.fps_t0 = 0, now\n",
    "\n",
    "    def focus_values(self, values):\n",
    "        \"\"\"The frame with everything except the picked hotspot flattened to the scene median.\"\"\"\n",
    "        if self.selected is None:\n",
    "            return values\n",
    "        ambient = self.detector.ambient\n",
    "        t = self.tracker.get(self.selected)\n",
    "        if t is None:\n",
    "            return np.full_like(values, ambient)\n",
    "        key = (t.id, t.hits)\n",
    "        if key != self.soft_key:\n",
    "            grown = cv.dilate(t.det.mask.astype(np.uint8), self.kernel).astype(np.float32)\n",
    "            self.soft = cv.GaussianBlur(grown, (0, 0), 1.5)\n",
    "            self.soft_key = key\n",
    "        return (ambient + (values - ambient) * self.soft).astype(np.float32)\n",
    "\n",
    "    def draw(self, values, focused, now):\n",
    "        \"\"\"Refresh the whole window. Returns False once it has been closed.\"\"\"\n",
    "        s = self.scale\n",
    "        for image, data in ((self.live_img, values), (self.focus_img, focused)):\n",
    "            image.set_data(data)\n",
    "            image.set_clim(s.low, s.high)\n",
    "        listed = self.tracker.listed()\n",
    "        picked = self.tracker.get(self.selected)\n",
    "        self._draw_maps(listed, picked)\n",
    "        self.message_text.set_text(self.message if time.monotonic() < self.message_until else \"\")\n",
    "\n",
    "        canvas = self.fig.canvas\n",
    "        full = (not self.blit or self.background is None\n",
    "                or time.monotonic() - self.last_full >= self.cfg.full_update_seconds)\n",
    "        if full:\n",
    "            self._draw_list(listed, picked, now)\n",
    "            self._draw_info(listed, picked, now)\n",
    "            self._draw_chart(listed, picked, now)\n",
    "            self._draw_3d()\n",
    "            canvas.draw()                  # triggers _on_draw, which adds the fast parts\n",
    "            self.last_full = time.monotonic()\n",
    "        else:\n",
    "            canvas.restore_region(self.background)\n",
    "            self._draw_fast_artists()\n",
    "            canvas.blit(self.fig.bbox)\n",
    "        canvas.start_event_loop(0.001)\n",
    "        return not self.closed and plt.fignum_exists(self.fig.number)\n",
    "\n",
    "    def _draw_maps(self, listed, picked):\n",
    "        shown = [t for t in listed if t.missed <= 2]\n",
    "        self.drawn = shown\n",
    "        for i, t in enumerate(shown):\n",
    "            rect, label = self._box(self.ax_live, self.live_boxes, i)\n",
    "            if picked is None:\n",
    "                self._place_box(rect, label, t, 1.4, \"-\", 1.0)\n",
    "            elif t is picked:\n",
    "                self._place_box(rect, label, t, 2.6, \"-\", 1.0)\n",
    "            else:\n",
    "                self._place_box(rect, label, t, 1.0, \"--\", 0.45)\n",
    "        self._hide(self.live_boxes, len(shown))\n",
    "        n = len(shown)\n",
    "        self.live_title.set_text(f\"LIVE MAP  ·  {n} hotspot{'s' if n != 1 else ''}  ·  click a box to track it\")\n",
    "\n",
    "        if picked is not None:\n",
    "            rect, label = self._box(self.ax_focus, self.focus_boxes, 0)\n",
    "            self._place_box(rect, label, picked, 2.6, \"-\" if picked.missed == 0 else \"--\", 1.0)\n",
    "            for marker in (self.live_peak, self.focus_peak):\n",
    "                marker.set_data([picked.det.peak_xy[0]], [picked.det.peak_xy[1]])\n",
    "            self.focus_note.set_visible(False)\n",
    "            title = f\"TRACKED ONLY  ·  hotspot #{picked.id}\"\n",
    "        else:\n",
    "            self._hide(self.focus_boxes)\n",
    "            for marker in (self.live_peak, self.focus_peak):\n",
    "                marker.set_data([], [])\n",
    "            gone = self.selected is not None\n",
    "            self.focus_note.set_text(f\"Hotspot #{self.selected} is gone\\npick another one\" if gone else\n",
    "                                     \"Nothing picked: showing every hotspot\\nclick a box on the live map\")\n",
    "            self.focus_note.set_visible(gone or not shown)\n",
    "            title = \"TRACKED ONLY  ·  \" + (f\"#{self.selected} (gone)\" if gone else \"all hotspots\")\n",
    "        self.focus_title.set_text(title)\n",
    "\n",
    "    def _draw_list(self, listed, picked, now):\n",
    "        u = self.scale.label\n",
    "        rows = listed[:self.ROWS]\n",
    "        self.row_ids = [t.id for t in rows]\n",
    "        more = len(listed) - len(rows)\n",
    "        self.list_title.set_text(f\"HOTSPOTS  ·  {len(listed)}\" + (f\"  (+{more} not shown)\" if more else \"\"))\n",
    "        for i, (swatch, text) in enumerate(zip(self.row_swatch, self.row_text)):\n",
    "            if i >= len(rows):\n",
    "                swatch.set_visible(False)\n",
    "                text.set_visible(False)\n",
    "                continue\n",
    "            t = rows[i]\n",
    "            status = \"live\" if t.missed == 0 else f\"missing {now - t.last_seen:.0f}s\"\n",
    "            alpha = 0.45 if picked is not None and t is not picked else 1.0\n",
    "            swatch.set_color(spot_color(t.id))\n",
    "            text.set_text(f\"#{t.id:<3d}{t.det.peak:6.1f} {u}   peak {t.high:5.1f}   {status}\")\n",
    "            for artist in (swatch, text):\n",
    "                artist.set_alpha(alpha)\n",
    "                artist.set_visible(True)\n",
    "        if picked is not None and picked in rows:\n",
    "            self.row_bg.set_y(self.ROW_TOP - rows.index(picked) * self.ROW_GAP - self.ROW_GAP * 0.46)\n",
    "            self.row_bg.set_visible(True)\n",
    "        else:\n",
    "            self.row_bg.set_visible(False)\n",
    "        self.list_note.set_text(\"\" if rows else \"No hotspots right now\")\n",
    "\n",
    "    def _draw_info(self, listed, picked, now):\n",
    "        u, cfg = self.scale.label, self.cfg\n",
    "        if picked is not None:\n",
    "            t, d = picked, picked.det\n",
    "            if t.missed == 0:\n",
    "                status = \"tracking\"\n",
    "            elif t.missed <= cfg.forget_frames:\n",
    "                status = f\"searching... {now - t.last_seen:.1f} s\"\n",
    "            else:\n",
    "                status = f\"lost, last seen {now - t.last_seen:.0f} s ago\"\n",
    "            cx, cy = t.center\n",
    "            rows = [\n",
    "                (\"Hotspot\", f\"#{t.id}\"),\n",
    "                (\"Status\", status),\n",
    "                (\"Temp now\", f\"{d.peak:.1f} {u}\" + (\"\" if t.missed == 0 else \"  (last seen)\")),\n",
    "                (\"Region mean\", f\"{d.mean:.1f} {u}\"),\n",
    "                (\"Recorded peak\", f\"{t.high:.1f} {u}\"),\n",
    "                (\"Recorded low\", f\"{t.low:.1f} {u}\"),\n",
    "                (\"Recorded avg\", f\"{t.average:.1f} {u}\"),\n",
    "                (\"Recorded for\", f\"{t.last_seen - t.first_seen:.1f} s  ({t.hits} samples)\"),\n",
    "                (\"Position\", f\"x {cx:.0f}, y {cy:.0f} px\"),\n",
    "                (\"Box size\", f\"{d.box[2]} x {d.box[3]} px  ({d.area} px)\"),\n",
    "                (\"Distance moved\", f\"{t.distance:.0f} px\"),\n",
    "                (\"From start\", f\"{np.hypot(cx - t.start[0], cy - t.start[1]):.0f} px\"),\n",
    "                (\"Speed\", f\"{t.speed():.1f} px/s\"),\n",
    "            ]\n",
    "            self.info_title.set_text(f\"PICKED HOTSPOT  #{t.id}\")\n",
    "            self.info_title.set_color(spot_color(t.id))\n",
    "        else:\n",
    "            live = [t for t in listed if t.missed == 0]\n",
    "            hottest = max(live, key=lambda t: t.det.peak, default=None)\n",
    "            s = self.scale\n",
    "            rows = [\n",
    "                (\"Tracking\", \"all hotspots\" if self.selected is None else f\"#{self.selected} (gone)\"),\n",
    "                (\"Hotspots now\", str(len(live))),\n",
    "                (\"Hottest\", f\"#{hottest.id}   {hottest.det.peak:.1f} {u}\" if hottest else \"-\"),\n",
    "                (\"Scene median\", f\"{self.detector.ambient:.1f} {u}\"),\n",
    "                (\"Hotspot above\", f\"{self.detector.threshold:.1f} {u}\"),\n",
    "                (\"Colour scale\", f\"{s.low:.1f} to {s.high:.1f} {u}\"),\n",
    "                (\"Frame rate\", f\"{self.fps:.1f} fps\"),\n",
    "                (\"\", \"\"),\n",
    "                (\"Tip\", \"click a box or a list row\"),\n",
    "                (\"\", \"to track a single hotspot\"),\n",
    "            ]\n",
    "            self.info_title.set_text(\"OVERVIEW\")\n",
    "            self.info_title.set_color(MUTED)\n",
    "        self.info_keys.set_text(\"\\n\".join(k for k, _ in rows))\n",
    "        self.info_vals.set_text(\"\\n\".join(v for _, v in rows))\n",
    "\n",
    "    def _draw_chart(self, listed, picked, now):\n",
    "        cfg, ax = self.cfg, self.ax_chart\n",
    "        since = now - cfg.chart_seconds\n",
    "        tracks = [picked] if picked is not None else [t for t in listed if t.missed <= cfg.forget_frames][:8]\n",
    "        while len(self.chart_lines) < len(tracks):\n",
    "            self.chart_lines.append(ax.plot([], [], lw=1.3)[0])\n",
    "        lo, hi = np.inf, -np.inf\n",
    "        for line, t in zip(self.chart_lines, tracks):\n",
    "            data = np.array([(e[0], e[1], e[2]) for e in t.recent(since)]).reshape(-1, 3)\n",
    "            line.set_data(data[:, 0] - now, data[:, 1])\n",
    "            line.set_color(spot_color(t.id))\n",
    "            line.set_linewidth(2.0 if picked is not None else 1.3)\n",
    "            line.set_visible(True)\n",
    "            if len(data):\n",
    "                lo, hi = min(lo, data[:, 1:].min()), max(hi, data[:, 1].max())\n",
    "            if t is picked:\n",
    "                self.mean_line.set_data(data[:, 0] - now, data[:, 2])\n",
    "        for line in self.chart_lines[len(tracks):]:\n",
    "            line.set_visible(False)\n",
    "        self.mean_line.set_visible(picked is not None)\n",
    "        if picked is not None:\n",
    "            self.peak_line.set_ydata([picked.high, picked.high])\n",
    "            hi = max(hi, picked.high)\n",
    "        self.peak_line.set_visible(picked is not None)\n",
    "        if not np.isfinite(lo):\n",
    "            lo, hi = self.scale.low, self.scale.high\n",
    "        pad = max(0.5, 0.08 * (hi - lo))\n",
    "        ax.set_ylim(lo - pad, hi + pad)\n",
    "        ax.set_xlim(-cfg.chart_seconds, 0)\n",
    "        title = (f\"TEMPERATURE  #{picked.id}   (solid max, dashed mean, dotted recorded peak)\"\n",
    "                 if picked is not None else \"TEMPERATURE  ·  all hotspots (max)\")\n",
    "        ax.set_title(title, color=MUTED, fontsize=8.5, loc=\"left\")\n",
    "\n",
    "    def _draw_3d(self):\n",
    "        if not self.history.rows:\n",
    "            return\n",
    "        grid = cv.GaussianBlur(self.history.as_array(), (0, 0),\n",
    "                               sigmaX=self.cfg.blur_x, sigmaY=self.cfg.blur_t)\n",
    "        for panel in self.panels:\n",
    "            panel.draw(grid)\n",
    "        what = f\"hotspot #{self.selected}\" if self.selected is not None else \"all hotspots\"\n",
    "        self.panels[0].ax.set_title(f\"3D map  ·  {what}\", color=TEXT, fontsize=10)\n",
    "        self.panels[1].ax.set_title(f\"Wisps  ·  {what}\", color=TEXT, fontsize=10)\n",
    "\n",
    "\n",
    "def run(cfg=Config()):\n",
    "    if \"inline\" in matplotlib.get_backend().lower():\n",
    "        raise RuntimeError(\"Inline backend closes the figure. Run %matplotlib qt, then restart the kernel.\")\n",
    "\n",
    "    camera = make_camera(cfg)\n",
    "    if cfg.simulate:\n",
    "        print(\"SIMULATION: synthetic thermal scene (set Config.simulate=False for the real camera).\")\n",
    "    else:\n",
    "        print(\"Reading temperatures (°C).\" if camera.raw else \"Reading brightness only: this camera sends processed frames.\")\n",
    "    detector, tracker = HotspotDetector(cfg), Tracker(cfg)\n",
    "    app = history = None\n",
    "    last_update = 0.0\n",
    "\n",
    "    try:\n",
    "        while True:\n",
    "            values = camera.read()\n",
    "            if values is None:\n",
    "                break\n",
    "            now = time.monotonic()\n",
    "            camera.scale.update(values)\n",
    "            tracker.update(detector.detect(values, camera.scale), now,\n",
    "                           keep=app.selected if app is not None else None)\n",
    "\n",
    "            if app is None:\n",
    "                history = History(values.shape[1], cfg)\n",
    "                app = ThermalApp(cfg, camera.scale, history, tracker, detector, values.shape, cfg.simulate)\n",
    "\n",
    "            app.tick(now)\n",
    "            focused = app.focus_values(values)\n",
    "            history.add_frame(focused)\n",
    "\n",
    "            if now - last_update >= cfg.update_seconds:\n",
    "                last_update = now\n",
    "                history.commit()\n",
    "                if not app.draw(values, focused, now):\n",
    "                    break\n",
    "    finally:\n",
    "        camera.release()\n",
    "        plt.close(\"all\")\n",
    "\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    run()"
   ]
  }
