   ],
   "source": [
    "#simulated - one window: live map with hotspot boxes, tracked-only view, 3D views and data panels SIMULATED\n",
    "# Drawn with pyqtgraph + OpenGL. Run the install cell first, and restart the kernel before re-running.\n",
    "#\n",
    "#   1. Setup              4. Hotspots (detect + track)     7. run()  <- start here\n",
    "#   2. Settings           5. 3D views\n",
    "#   3. Frame sources      6. The window\n",
    "import ctypes\n",
    "import sys\n",
    "import threading\n",
    "import time\n",
    "from collections import deque\n",
    "from concurrent.futures import ThreadPoolExecutor\n",
    "from dataclasses import dataclass\n",
    "from itertools import takewhile\n",
    "\n",
    "import cv2 as cv\n",
    "import numpy as np\n",
    "import OpenGL\n",
    "OpenGL.ERROR_CHECKING = False            # PyOpenGL checks every GL call by default: slow\n",
    "import pyqtgraph as pg                   # noqa: E402\n",
    "import pyqtgraph.opengl as gl            # noqa: E402\n",
    "from pyqtgraph.Qt import QtCore, QtGui, QtWidgets   # noqa: E402\n",
    "\n",
    "Qt = QtCore.Qt\n",
    "QShortcut = getattr(QtGui, \"QShortcut\", None) or QtWidgets.QShortcut   # Qt6 / Qt5\n",
    "\n",
    "# The OpenGL views must not each wait for the screen refresh: FramePacer waits once per frame.\n",
    "# (Only takes effect before the first OpenGL view exists - hence \"restart the kernel\".)\n",
    "_format = QtGui.QSurfaceFormat.defaultFormat()\n",
    "_format.setSwapInterval(0)\n",
    "QtGui.QSurfaceFormat.setDefaultFormat(_format)\n",
    "\n",
    "'''\n",
    "def use_window_backend():\n",
    "    \"\"\"Notebooks default to an inline backend that closes live figures.\"\"\"\n",
    "    try:\n",
    "        shell = get_ipython()\n",
    "    except NameError:\n",
    "        return\n",
    "    for backend in (\"qt\", \"tk\"):\n",
    "        try:\n",
    "            shell.run_line_magic(\"matplotlib\", backend)\n",
    "            return\n",
    "        except Exception:\n",
    "            continue\n",
    "\n",
    "\n",
    "use_window_backend()\n",
    "import matplotlib.pyplot as plt  # noqa: E402\n",
    "from matplotlib.cm import ScalarMappable  # noqa: E402\n",
    "from matplotlib.colors import Normalize  # noqa: E402\n",
    "\n",
    "'''\n",
    "\n",
    "# ==============================================================================================\n",
    "# 2. Settings\n",
    "# ==============================================================================================\n",
    "\n",
    "FRAME_SHAPE = (384, 256, 2)\n",
    "FRAME_SIZE = int(np.prod(FRAME_SHAPE))\n",
    "FONT = cv.FONT_HERSHEY_SIMPLEX\n"
    "@dataclass\n",
    "class Config:\n",
    "    simulate: bool = True             # True = synthetic scene, False = real TC001 camera\n",
    "    sim_fps: float = 60.0             # target rate; snapped to the screen (144 Hz -> 72 fps)\n",
    "    camera_index: int = 0\n",
    "    left_crop: int = 98               # gray (fallback) camera mode only\n",
    "    window_size: tuple = (1800, 1000)\n",
    "\n",
    "    # 3D views\n",
    "    rows: int = 80                    # time rows kept\n",
    "    columns: int = 64                 # columns across the image\n",
    "    update_seconds: float = 0.08      # time per row\n",
    "    blur_x: float = 0.8               # smoothing across columns\n",
    "    blur_t: float = 1.0               # smoothing across time\n",
    "    panel_seconds: float = 0.2        # list / data / chart refresh interval\n",
    "\n",
    "    # colour scale: starts at temp_min..temp_max, then follows the scene\n",
    "    temp_min: float = 10.0\n",
    "    temp_max: float = 50.0\n",
    "    auto_scale: bool = True\n",
    "    scale_low_pct: float = 1.0\n",
    "    scale_high_pct: float = 99.8\n",
    "    min_span: float = 6.0             # never tighter than this many degrees\n",
    "    scale_smoothing: float = 0.08     # 0..1, lower = steadier\n",
    "\n",
    "    # wisps\n",
    "    ambient_pct: float = 30.0         # \"normal\" = this percentile of the history\n",
    "    contrast: float = 0.15            # fraction of the scale span that makes a wisp fully strong\n",
    "    min_strength: float = 0.15        # weaker cells are not drawn\n",
    "\n",
    "    # hotspot detection\n",
    "    hot_delta: float = 4.0            # hotspot = this much above the scene median...\n",
    "    hot_fraction: float = 0.12        # ...or this fraction of the scale span, whichever is larger\n",
    "    prominence: float = 5.0           # a peak needs this rise above the dip to a hotter neighbour\n",
    "    min_area: int = 20                # pixels\n",
    "    min_rise: float = 1.5             # peak must be this far above the hotspot level\n",
    "    detect_step: int = 2              # detect on an image this many times smaller (speed)\n",
    "\n",
    "    # hotspot tracking\n",
    "    match_distance: float = 30.0      # pixels a hotspot may jump and keep its ID...\n",
    "    max_speed: float = 80.0           # ...plus this many pixels per second since last seen\n",
    "    confirm_frames: int = 3           # frames before a hotspot gets an ID\n",
    "    forget_frames: int = 20           # frames a hotspot may be missing before it is dropped\n",
    "    focus_margin: int = 4             # pixels kept around the picked hotspot\n",
    "    chart_seconds: float = 30.0       # length of the temperature chart\n",
    "    log_length: int = 30000           # samples kept per hotspot (chart + CSV)\n",
    "\n",
    "\n",
    "# ==============================================================================================\n",
    "# 3. Frame sources: real camera, simulated scene, and the frame pacer\n",
    "# ==============================================================================================\n",
    "\n",
    "FRAME_SHAPE = (384, 256, 2)           # raw TC001 frame: image half + temperature half\n",
    "FRAME_SIZE = int(np.prod(FRAME_SHAPE))\n",
    "\n",
    "\n",
    "class Scale:\n",
    "    \"\"\"Colour/height range shared by every view. Follows the scene; rises fast so nothing clips.\"\"\"\n",
    "\n",
    "    def __init__(self, low, high, unit, auto, cfg):\n",
    "        self.low, self.high, self.auto, self.cfg = low, high, auto, cfg\n",
    "        self.label = \"°C\" if unit == \"C\" else unit\n",
    "        self.primed = False\n",
    "\n",
    "    @property\n",
    "    def span(self):\n",
    "        return max(self.high - self.low, 1e-6)\n",
    "\n",
    "    def update(self, values):\n",
    "        if not self.auto:\n",
    "            return\n",
    "        cfg = self.cfg\n",
    "        lo, hi = np.percentile(values[::2, ::2], (cfg.scale_low_pct, cfg.scale_high_pct))\n",
    "        hi = max(hi, lo + cfg.min_span)\n",
    "        if not self.primed:\n",
    "            self.low, self.high, self.primed = float(lo), float(hi), True\n",
    "            return\n",
    "        self.low += cfg.scale_smoothing * (lo - self.low)\n",
    "        self.high += (0.5 if hi > self.high else cfg.scale_smoothing) * (hi - self.high)\n",
    "\n",
    "\n",
    "def open_raw(index):\n",
    "    \"\"\"A capture that delivers raw TC001 frames, or None.\"\"\"\n",
    "    for name, backend in ((\"DSHOW\", cv.CAP_DSHOW), (\"MSMF\", cv.CAP_MSMF), (\"default\", cv.CAP_ANY)):\n",
    "        capture = cv.VideoCapture(index, backend)\n",
    "        if capture.isOpened():\n",
    "            capture.set(cv.CAP_PROP_CONVERT_RGB, 0)\n",
    "            ok, frame = capture.read()\n",
    "            print(f\"[{name}] read ok={ok}, size={getattr(frame, 'size', None)} (need {FRAME_SIZE})\")\n",
    "            if ok and frame.size == FRAME_SIZE:\n",
    "                return capture\n",
    "        capture.release()\n",
    "    return None\n",
    "\n",
    "\n",
    "class Camera:\n",
    "    \"\"\"TC001 camera. A background thread keeps only the newest frame, so nothing queues up.\"\"\"\n",
    "\n",
    "    def __init__(self, cfg):\n",
    "        self.crop = cfg.left_crop\n",
    "        self.capture = open_raw(cfg.camera_index)\n",
    "        self.raw = self.capture is not None\n",
    "        if not self.raw:\n",
    "            self.capture = cv.VideoCapture(cfg.camera_index)\n",
    "        if not self.capture.isOpened():\n",
    "            raise RuntimeError(\"Could not open camera. Try another camera_index.\")\n",
    "        self.scale = (Scale(cfg.temp_min, cfg.temp_max, \"C\", cfg.auto_scale, cfg) if self.raw\n",
    "                      else Scale(0, 255, \"signal\", False, cfg))\n",
    "        self._frame, self._lock = None, threading.Lock()\n",
    "        self._ready, self._stop = threading.Event(), threading.Event()\n",
    "        self._thread = threading.Thread(target=self._grab, daemon=True)\n",
    "        self._thread.start()\n",
    "\n",
    "    def _grab(self):\n",
    "        while not self._stop.is_set():\n",
    "            ok, frame = self.capture.read()\n",
    "            with self._lock:\n",
    "                self._frame = frame if ok else None\n",
    "            self._ready.set()\n",
    "            if not ok:\n",
    "                break\n",
    "\n",
    "    def read(self):\n",
    "        \"\"\"Newest frame in °C (raw mode) or brightness 0..255; None if the camera stopped.\"\"\"\n",
    "        if not self._ready.wait(2.0):\n",
    "            return None\n",
    "        self._ready.clear()\n",
    "        with self._lock:\n",
    "            frame = self._frame\n",
    "        if frame is None:\n",
    "            return None\n",
    "        if not self.raw:\n",
    "            return cv.cvtColor(frame[:, self.crop:], cv.COLOR_BGR2GRAY).astype(np.float32)\n",
    "        data = frame.reshape(FRAME_SHAPE)[FRAME_SHAPE[0] // 2:]\n",
    "        raw = data[..., 0].astype(np.uint16) + data[..., 1].astype(np.uint16) * 256\n",
    "        return (raw / 64.0 - 273.15).astype(np.float32)\n",
    "\n",
    "    def release(self):\n",
    "        self._stop.set()\n",
    "        self._thread.join(timeout=2.0)\n",
    "        self.capture.release()\n",
    "\n",
    "\n",
    "class SimulatedCamera:\n",
    "    \"\"\"Stand-in for Camera with synthetic 192x256 °C frames, based on the clock (any frame rate).\n",
    "\n",
    "    A cool room with a warm wall on the right, a person walking side to side, a pulsing hot spot\n",
    "    (like a soldering iron) and a warm hand sweeping across the top every 9 s, plus sensor noise.\n",
    "    \"\"\"\n",
    "\n",
    "    H, W = 192, 256\n",
    "\n",
    "    def __init__(self, cfg):\n",
    "        self.raw = True\n",
    "        self.scale = Scale(cfg.temp_min, cfg.temp_max, \"C\", cfg.auto_scale, cfg)\n",
    "        self.rng = np.random.default_rng(1)\n",
    "        self.gx, self.gy = np.arange(self.W, dtype=np.float32), np.arange(self.H, dtype=np.float32)\n",
    "        texture = cv.resize(self.rng.normal(size=(12, 16)).astype(np.float32), (self.W, self.H),\n",
    "                            interpolation=cv.INTER_CUBIC)\n",
    "        wall = 3.0 * np.clip((self.gx - 150) / 106, 0, 1) ** 2\n",
    "        self.room = 21.0 + texture + wall[None, :]\n",
    "        self.t0 = time.monotonic()\n",
    "\n",
    "    def _blob(self, cx, cy, sx, sy, amp):\n",
    "        bx = np.exp(-((self.gx - cx) ** 2) / (2 * sx * sx))\n",
    "        by = np.exp(-((self.gy - cy) ** 2) / (2 * sy * sy))\n",
    "        return amp * by[:, None] * bx[None, :]\n",
    "\n",
    "    def read(self):\n",
    "        t = time.monotonic() - self.t0\n",
    "        px, py = self.W / 2 + 70 * np.sin(0.35 * t), self.H * 0.62 + 6 * np.sin(1.1 * t)\n",
    "        sweep = (t % 9.0) / 9.0\n",
    "        frame = (self.room\n",
    "                 + self._blob(px, py, 22, 48, 11.0)                                  # torso\n",
    "                 + self._blob(px, py - 58, 10, 12, 13.0)                             # head\n",
    "                 + self._blob(238, 150, 5, 5, 24 + 8 * np.sin(1.7 * t))              # pulsing spot\n",
    "                 + self._blob(-20 + sweep * (self.W + 40), 50, 8, 8, 14 * np.sin(np.pi * sweep))  # hand\n",
    "                 + self.rng.normal(0, 0.08, self.room.shape))\n",
    "        return frame.astype(np.float32)\n",
    "\n",
    "    def release(self):\n",
    "        pass\n",
    "\n",
    "\n",
    "class FramePacer:\n",
    "    \"\"\"Times frames to the screen's refresh so every frame stays up equally long.\n",
    "\n",
    "    A plain 60 fps timer on a 144 Hz screen shows frames for 2, 3, 2, 3... refreshes, which looks\n",
    "    like stutter. Instead we wait for real refreshes (Windows DwmFlush) and show each frame for a\n",
    "    whole number of them: 60 Hz -> 60 fps, 144 Hz -> 72 fps, 120 Hz -> 60 fps.\n",
    "\n",
    "    If this computer can't keep up (over 15% of frames late), it steps down to the next even\n",
    "    rhythm (e.g. 72 -> 48 fps): a steady lower rate looks far smoother than one that stutters.\n",
    "    \"\"\"\n",
    "\n",
    "    MAX_LATE = 0.15\n",
    "    WARMUP = 100                                        # first frames (window opening) don't count\n",
    "\n",
    "    def __init__(self, fps):\n",
    "        self.period, self.refresh, self.flush = 1.0 / fps, None, None\n",
    "        try:\n",
    "            flush = ctypes.windll.dwmapi.DwmFlush\n",
    "            stamps = []\n",
    "            for _ in range(40):                         # ~0.3 s of refreshes\n",
    "                if flush() != 0:\n",
    "                    raise OSError\n",
    "                stamps.append(time.perf_counter())\n",
    "            refresh = float(np.median(np.diff(stamps)))\n",
    "            if 0.002 < refresh < 0.05:\n",
    "                self.flush, self.refresh = flush, refresh\n",
    "                self.period = max(1, int(self.period / refresh + 0.05)) * refresh\n",
    "        except (AttributeError, OSError):\n",
    "            pass                                        # not Windows: fall back to a timer\n",
    "        self.next = self.started = time.perf_counter()\n",
    "        self.frames = self.late = 0\n",
    "        self.recent = deque(maxlen=120)                 # late (True) / on time, last 120 frames\n",
    "\n",
    "    @property\n",
    "    def fps(self):\n",
    "        return 1.0 / self.period\n",
    "\n",
    "    def wait(self):\n",
    "        \"\"\"Return just after the refresh on which the next frame should appear.\"\"\"\n",
    "        if self.flush is None:\n",
    "            late = time.perf_counter() > self.next + 0.25 * self.period\n",
    "            time.sleep(max(0.0, self.next - time.perf_counter()))\n",
    "            self.next = max(self.next + self.period, time.perf_counter())\n",
    "        else:\n",
    "            while True:\n",
    "                self.flush()                            # blocks until the next refresh\n",
    "                now = time.perf_counter()\n",
    "                if now >= self.next - 0.5 * self.refresh:\n",
    "                    break\n",
    "            late = now > self.next + 0.5 * self.refresh     # missed its refresh\n",
    "            self.next = now + self.period\n",
    "        self._count(late)\n",
    "\n",
    "    def _count(self, late):\n",
    "        self.frames += 1\n",
    "        if self.frames <= self.WARMUP:\n",
    "            return\n",
    "        self.late += late\n",
    "        self.recent.append(late)\n",
    "        too_slow = len(self.recent) == self.recent.maxlen and sum(self.recent) > self.MAX_LATE * len(self.recent)\n",
    "        if too_slow and self.refresh and self.fps > 25:\n",
    "            self.period += self.refresh\n",
    "            self.recent.clear()\n",
    "            print(f\"This computer can't keep up: switching to a steady {self.fps:.0f} fps.\")\n",
    "\n",
    "    def report(self):\n",
    "        seconds = time.perf_counter() - self.started\n",
    "        on_time = 100 * (1 - self.late / max(self.frames - self.WARMUP, 1))\n",
    "        return (f\"Ran {self.frames} frames in {seconds:.0f} s ({self.frames / max(seconds, 1e-9):.0f} fps), \"\n",
    "                f\"{on_time:.0f}% on time. Final rate {self.fps:.0f} fps.\")\n",
    "\n",
    "\n",
    "# ==============================================================================================\n",
    "# 4. Hotspots: find them in each frame, then follow them over time\n",
    "# ==============================================================================================\n",
    "\n",
    "@dataclass\n",
    "class Detection:\n",
    "    box: tuple          # x, y, w, h in image pixels\n",
    "    center: tuple       # heat-weighted centre (x, y)\n",
    "    peak: float         # hottest reading\n",
    "    peak_xy: tuple      # where that reading is\n",
    "    mean: float         # average reading\n",
    "    area: int           # pixels\n",
    "    mask: np.ndarray    # bool image, True inside the hotspot\n",
    "\n",
    "\n",
    "def segment_peaks(img, threshold, prominence):\n",
    "    \"\"\"Label pixels above `threshold`, one label per peak that clearly stands on its own.\n",
    "\n",
    "    Pixels join a touching neighbour's region, hottest first. When two regions meet, the cooler\n",
    "    one is merged unless its peak rises `prominence` above the meeting point - so a head on a\n",
    "    body stays one hotspot, while a person next to a hot mug gives two.\n",
    "    \"\"\"\n",
    "    h, w = img.shape\n",
    "    pw = w + 2\n",
    "    padded = np.full((h + 2, pw), -np.inf, np.float32)\n",
    "    padded[1:-1, 1:-1] = img\n",
    "    flat = padded.ravel()\n",
    "    idx = np.flatnonzero(flat > threshold)\n",
    "    if idx.size == 0:\n",
    "        return np.zeros((h, w), np.int32)\n",
    "\n",
    "    order = idx[np.argsort(-flat[idx], kind=\"stable\")]\n",
    "    neighbours = (-pw - 1, -pw, -pw + 1, -1, 1, pw - 1, pw, pw + 1)\n",
    "    owner, parent, peak = {}, [], []          # pixel -> region, region tree, region peak\n",
    "\n",
    "    def root(r):\n",
    "        while parent[r] != r:\n",
    "            parent[r] = parent[parent[r]]\n",
    "            r = parent[r]\n",
    "        return r\n",
    "\n",
    "    for p, v in zip(order.tolist(), flat[order].tolist()):\n",
    "        roots = []\n",
    "        for o in neighbours:\n",
    "            r = owner.get(p + o)\n",
    "            if r is not None and (r := root(r)) not in roots:\n",
    "                roots.append(r)\n",
    "        if not roots:                             # a new peak\n",
    "            owner[p] = len(parent)\n",
    "            parent.append(len(parent))\n",
    "            peak.append(v)\n",
    "            continue\n",
    "        roots.sort(key=peak.__getitem__, reverse=True)\n",
    "        for r in roots[1:]:\n",
    "            if peak[r] - v < prominence:          # not prominent enough: merge into the hotter one\n",
    "                parent[r] = roots[0]\n",
    "        owner[p] = roots[0]\n",
    "\n",
    "    names = {}\n",
    "    pixels = np.fromiter(owner.keys(), np.int64, len(owner))\n",
    "    labels = np.fromiter((names.setdefault(root(r), len(names) + 1) for r in owner.values()),\n",
    "                         np.int32, len(owner))\n",
    "    out = np.zeros(flat.size, np.int32)\n",
    "    out[pixels] = labels\n",
    "    return out.reshape(h + 2, pw)[1:-1, 1:-1].copy()\n",
    "\n",
    "\n",
    "class HotspotDetector:\n",
    "    \"\"\"Finds the regions clearly hotter than the scene and measures each one.\"\"\"\n",
    "\n",
    "    def __init__(self, cfg):\n",
    "        self.cfg = cfg\n",
    "        self.ambient = self.threshold = None      # smoothed scene median / current hotspot level\n",
    "\n",
    "    def detect(self, values, scale):\n",
    "        cfg = self.cfg\n",
    "        blurred = cv.GaussianBlur(values, (0, 0), 1.2)\n",
    "        median = float(np.median(blurred[::2, ::2]))\n",
    "        self.ambient = median if self.ambient is None else self.ambient + 0.1 * (median - self.ambient)\n",
    "        self.threshold = self.ambient + max(cfg.hot_delta, cfg.hot_fraction * scale.span)\n",
    "\n",
    "        # Segment a smaller copy (much faster), then scale the labels back up.\n",
    "        h, w = values.shape\n",
    "        f = max(1, int(cfg.detect_step))\n",
    "        small = cv.resize(blurred, (w // f, h // f), interpolation=cv.INTER_AREA) if f > 1 else blurred\n",
    "        small_labels = segment_peaks(small, self.threshold, max(cfg.prominence, 0.08 * scale.span))\n",
    "        labels = np.zeros((h, w), np.int32)\n",
    "        up = small_labels.repeat(f, axis=0).repeat(f, axis=1)\n",
    "        labels[:up.shape[0], :up.shape[1]] = up\n",
    "        labels[blurred <= self.threshold] = 0\n",
    "\n",
    "        found = []\n",
    "        for label in range(1, int(small_labels.max()) + 1):\n",
    "            mask = labels == label\n",
    "            ys, xs = np.nonzero(mask)\n",
    "            if xs.size < cfg.min_area or blurred[ys, xs].max() < self.threshold + cfg.min_rise:\n",
    "                continue                          # too small, or barely warm (texture, edges)\n",
    "            weight = np.clip(blurred[ys, xs] - self.ambient, 1e-3, None)\n",
    "            readings = values[ys, xs]\n",
    "            k = int(np.argmax(readings))\n",
    "            x0, y0 = int(xs.min()), int(ys.min())\n",
    "            found.append(Detection(\n",
    "                box=(x0, y0, int(xs.max()) - x0 + 1, int(ys.max()) - y0 + 1),\n",
    "                center=(float(xs @ weight / weight.sum()), float(ys @ weight / weight.sum())),\n",
    "                peak=float(readings[k]), peak_xy=(int(xs[k]), int(ys[k])),\n",
    "                mean=float(readings.mean()), area=int(xs.size), mask=mask))\n",
    "        return found\n",
    "\n",
    "\n",
    "class Track:\n",
    "    \"\"\"One hotspot followed over time, with everything recorded about it.\"\"\"\n",
    "\n",
    "    def __init__(self, det, now, cfg):\n",
    "        self.id = None                                  # given once the hotspot is confirmed\n",
    "        self.center = self.start = self.pos = det.center    # smoothed / first / raw centre\n",
    "        self.vel = (0.0, 0.0)                           # pixels per second, smoothed\n",
    "        self.first_seen = self.last_seen = now\n",
    "        self.hits = self.missed = 0\n",
    "        self.distance = self.total = 0.0\n",
    "        self.high, self.low = -np.inf, np.inf\n",
    "        self.log = deque(maxlen=cfg.log_length)         # (t, peak, mean, cx, cy, bx, by, bw, bh)\n",
    "        self.see(det, now)\n",
    "\n",
    "    def see(self, det, now):\n",
    "        if self.hits:\n",
    "            dt = now - self.last_seen\n",
    "            if dt > 0:\n",
    "                vx, vy = (det.center[0] - self.pos[0]) / dt, (det.center[1] - self.pos[1]) / dt\n",
    "                self.vel = (self.vel[0] + 0.4 * (vx - self.vel[0]), self.vel[1] + 0.4 * (vy - self.vel[1]))\n",
    "            cx, cy = self.center\n",
    "            nx, ny = (cx + det.center[0]) / 2, (cy + det.center[1]) / 2\n",
    "            self.distance += float(np.hypot(nx - cx, ny - cy))\n",
    "            self.center, self.pos = (nx, ny), det.center\n",
    "        self.det, self.last_seen = det, now\n",
    "        self.hits, self.missed = self.hits + 1, 0\n",
    "        self.high, self.low = max(self.high, det.peak), min(self.low, det.peak)\n",
    "        self.total += det.peak\n",
    "        self.log.append((now, det.peak, det.mean, *self.center, *det.box))\n",
    "\n",
    "    def predict(self, now):\n",
    "        dt = min(now - self.last_seen, 1.0)\n",
    "        return self.pos[0] + self.vel[0] * dt, self.pos[1] + self.vel[1] * dt\n",
    "\n",
    "    @property\n",
    "    def average(self):\n",
    "        return self.total / max(self.hits, 1)\n",
    "\n",
    "    def recent(self, since):\n",
    "        \"\"\"Log entries newer than `since`, oldest first.\"\"\"\n",
    "        return list(takewhile(lambda e: e[0] >= since, reversed(self.log)))[::-1]\n",
    "\n",
    "    def speed(self, window=1.0):\n",
    "        \"\"\"Pixels per second over the last `window` seconds.\"\"\"\n",
    "        span = self.recent(self.log[-1][0] - window) if self.log else []\n",
    "        if len(span) < 2 or span[-1][0] <= span[0][0]:\n",
    "            return 0.0\n",
    "        a, b = span[0], span[-1]\n",
    "        return float(np.hypot(b[3] - a[3], b[4] - a[4]) / (b[0] - a[0]))\n",
    "\n",
    "\n",
    "class Tracker:\n",
    "    \"\"\"Keeps hotspot IDs stable by matching each detection to the nearest predicted track.\"\"\"\n",
    "\n",
    "    def __init__(self, cfg):\n",
    "        self.cfg, self.tracks, self.next_id = cfg, [], 1\n",
    "\n",
    "    def update(self, detections, now, keep=None):\n",
    "        cfg = self.cfg\n",
    "        pairs = []                                      # (distance, track, detection) within reach\n",
    "        for i, t in enumerate(self.tracks):\n",
    "            px, py = t.predict(now)\n",
    "            reach = cfg.match_distance + cfg.max_speed * min(now - t.last_seen, 0.75)\n",
    "            for j, d in enumerate(detections):\n",
    "                dist = float(np.hypot(px - d.center[0], py - d.center[1]))\n",
    "                if dist <= reach:\n",
    "                    pairs.append((dist, i, j))\n",
    "        pairs.sort()\n",
    "        used_t, used_d = set(), set()\n",
    "        for _, i, j in pairs:                           # closest pairs first\n",
    "            if i not in used_t and j not in used_d:\n",
    "                used_t.add(i)\n",
    "                used_d.add(j)\n",
    "                self.tracks[i].see(detections[j], now)\n",
    "\n",
    "        survivors = []\n",
    "        for i, t in enumerate(self.tracks):\n",
    "            if i not in used_t:\n",
    "                t.missed += 1\n",
    "                limit = cfg.forget_frames if t.id is not None else 1\n",
    "                if t.missed > limit and (keep is None or t.id != keep):\n",
    "                    continue                            # gone (the picked one is always kept)\n",
    "            if t.id is None and t.hits >= cfg.confirm_frames:\n",
    "                t.id, self.next_id = self.next_id, self.next_id + 1\n",
    "            survivors.append(t)\n",
    "        self.tracks = survivors + [Track(d, now, cfg) for j, d in enumerate(detections) if j not in used_d]\n",
    "\n",
    "    def get(self, tid):\n",
    "        return next((t for t in self.tracks if t.id == tid), None) if tid is not None else None\n",
    "\n",
    "    def listed(self):\n",
    "        \"\"\"Confirmed hotspots, by ID.\"\"\"\n",
    "        return sorted((t for t in self.tracks if t.id is not None), key=lambda t: t.id)\n",
    "\n",
    "\n",
    "# ==============================================================================================\n",
    "# 5. 3D views: a rolling history of the hottest value per column, shown two ways\n",
    "# ==============================================================================================\n",
    "\n",
    "class History:\n",
    "    \"\"\"Rows of \"hottest value per column block\", one row per update_seconds, newest last.\"\"\"\n",
    "\n",
    "    def __init__(self, width, cfg):\n",
    "        self.step = max(1, width // cfg.columns)\n",
    "        self.n = width // self.step\n",
    "        self.x = np.arange(self.n) * self.step + self.step / 2\n",
    "        self.rows = deque(maxlen=cfg.rows)\n",
    "        self.serial = 0                                 # rows committed so far (never reset)\n",
    "        self.reset()\n",
    "\n",
    "    def reset(self):\n",
    "        self.rows.clear()\n",
    "        self.total, self.count = np.zeros(self.n, np.float32), 0\n",
    "\n",
    "    def add_frame(self, values):\n",
    "        blurred = cv.GaussianBlur(values, (0, 0), 1.0)                     # ignore single hot pixels\n",
    "        blocks = blurred[:, :self.n * self.step].reshape(blurred.shape[0], self.n, self.step)\n",
    "        self.total += blocks.max(axis=(0, 2))\n",
    "        self.count += 1\n",
    "\n",
    "    def commit(self):\n",
    "        if self.count:\n",
    "            row = self.total / self.count\n",
    "            self.rows.extend([row] * (self.rows.maxlen if not self.rows else 1))   # first row fills all\n",
    "            self.total, self.count = np.zeros(self.n, np.float32), 0\n",
    "            self.serial += 1\n",
    "\n",
    "    def with_live_row(self):\n",
    "        \"\"\"Committed rows plus the row still being filled.\"\"\"\n",
    "        live = self.total / self.count if self.count else self.rows[-1]\n",
    "        return np.vstack([np.asarray(self.rows, np.float32), live[None]])\n",
    "\n",
    "\n",
    "BG, PANEL, EDGE, TEXT, MUTED = \"#0c0e13\", \"#151821\", \"#2b303b\", \"#e3e6ec\", \"#8b92a3\"\n",
    "SPOT_COLORS = (\"#38d1ff\", \"#7dff6a\", \"#ff6bd6\", \"#f4f4f4\", \"#b69bff\", \"#00f5c4\", \"#6ba4ff\", \"#d4ff3a\")\n",
    "INFERNO = pg.colormap.get(\"inferno\")\n",
    "LUT_BGRA = np.c_[INFERNO.getLookupTable(0.0, 1.0, 256)[:, ::-1], np.full(256, 255, np.uint8)]  # 2D images\n",
    "LUT_RGBA = INFERNO.getLookupTable(0.0, 1.0, 256, alpha=True).astype(np.float32) / 255           # 3D colours\n",
    "\n",
    "\n",
    "def spot_color(tid):\n",
    "    return SPOT_COLORS[(tid - 1) % len(SPOT_COLORS)]\n",
    "\n",
    "\n",
    "def colour_index(values, low, span):\n",
    "    \"\"\"Readings -> 0..255 position on the colour scale.\"\"\"\n",
    "    return np.clip((values - low) * (255.0 / span), 0, 255).astype(np.uint8)\n",
    "\n",
    "\n",
    "def forget_gl_shaders():\n",
    "    \"\"\"Make pyqtgraph compile its OpenGL shaders again for the new window.\n",
    "\n",
    "    pyqtgraph compiles shaders once and caches them for the whole Python session, but compiled\n",
    "    shaders belong to the window that compiled them. Running the cell a second time opens a new\n",
    "    window, where the cached ones don't work and the 3D views come up empty.\n",
    "    \"\"\"\n",
    "    for program in gl.shaders.ShaderProgram.names.values():\n",
    "        program.prog = None\n",
    "        for shader in program.shaders:\n",
    "            shader.compiled = None\n",
    "    for item_class in vars(gl).values():\n",
    "        if isinstance(item_class, type) and \"_shaderProgram\" in vars(item_class):\n",
    "            item_class._shaderProgram = None\n",
    "\n",
    "\n",
    "class View3D:\n",
    "    \"\"\"An OpenGL 3D view: image X across, time going back, value up. Drag to rotate, wheel to zoom.\n",
    "\n",
    "    Rows glide: each frame the history slides by the fraction of a row that has passed, and the\n",
    "    row still filling is drawn at the edge, so the view never jumps.\n",
    "    \"\"\"\n",
    "\n",
    "    SX, SY, SZ = 256.0, 200.0, 110.0                   # size of the drawing box in GL units\n",
    "\n",
    "    def __init__(self, history, cfg, scale, height_label):\n",
    "        self.cfg, self.scale, self.height_label, self.range_text = cfg, scale, height_label, \"\"\n",
    "        self.widget = gl.GLViewWidget()\n",
    "        self.widget.setBackgroundColor(BG)\n",
    "        self.widget.setMinimumHeight(200)\n",
    "        self.xs = (history.x / history.x.max() * self.SX).astype(np.float32)\n",
    "        self.dy = self.SY / cfg.rows\n",
    "        self.ys = (np.arange(cfg.rows + 1) * self.dy).astype(np.float32)     # rows + the live one\n",
    "        grid = gl.GLGridItem()\n",
    "        grid.setSize(self.SX, self.SY)\n",
    "        grid.setSpacing(self.SX / 8, self.SY / 8)\n",
    "        grid.translate(self.SX / 2, self.SY / 2, 0)\n",
    "        grid.setColor((255, 255, 255, 35))\n",
    "        self.widget.addItem(grid)\n",
    "        self.widget.setCameraPosition(pos=QtGui.QVector3D(self.SX / 2, self.SY / 2, self.SZ * 0.3),\n",
    "                                      distance=360, elevation=34, azimuth=-112)\n",
    "\n",
    "    def place(self, item, frac, low, high):\n",
    "        item.resetTransform()\n",
    "        item.translate(0, -frac * self.dy, 0)\n",
    "        self.range_text = f\"height: {self.height_label}  {low:.1f} to {high:.1f}\"\n",
    "\n",
    "\n",
    "class Surface3D(View3D):\n",
    "    \"\"\"Surface of the hottest value per column over time.\"\"\"\n",
    "\n",
    "    def __init__(self, history, cfg, scale):\n",
    "        super().__init__(history, cfg, scale, f\"Signal ({scale.label})\")\n",
    "        self.surf = gl.GLSurfacePlotItem(x=self.xs, y=self.ys, z=np.zeros((self.xs.size, self.ys.size)),\n",
    "                                         computeNormals=False, smooth=False)\n",
    "        self.widget.addItem(self.surf)\n",
    "\n",
    "    def draw(self, grid, frac, serial, ease):\n",
    "        s = self.scale\n",
    "        level = colour_index(grid.T, s.low, s.span)                         # (columns, rows)\n",
    "        self.surf.setData(z=level * (self.SZ / 255), colors=LUT_RGBA[level].reshape(-1, 4))\n",
    "        self.place(self.surf, frac, s.low, s.high)\n",
    "\n",
    "\n",
    "class Wisps3D(View3D):\n",
    "    \"\"\"Glowing particles for everything hotter than the scene's normal level.\"\"\"\n",
    "\n",
    "    PARTICLES = 2\n",
    "\n",
    "    def __init__(self, history, cfg, scale):\n",
    "        super().__init__(history, cfg, scale, f\"{scale.label} above normal\")\n",
    "        self.gx, self.gy = (a.ravel() for a in np.meshgrid(self.xs, self.ys))\n",
    "        # Fixed random offsets per (row, column), tied to the row so particles move with it.\n",
    "        rng = np.random.default_rng(7)\n",
    "        self.jitter = rng.uniform(-0.5, 0.5, (self.PARTICLES, 3, self.ys.size, self.xs.size)).astype(np.float32)\n",
    "        self.dx = self.xs[1] - self.xs[0]\n",
    "        self.ambient = self.top = None\n",
    "        self.cloud = gl.GLScatterPlotItem(pos=np.zeros((1, 3)), color=(0, 0, 0, 0), size=1, pxMode=True)\n",
    "        self.cloud.setGLOptions(\"additive\")\n",
    "        self.widget.addItem(self.cloud)\n",
    "\n",
    "    def draw(self, grid, frac, serial, ease):\n",
    "        s, cfg, rows = self.scale, self.cfg, grid.shape[0]\n",
    "        normal = float(np.percentile(grid, cfg.ambient_pct))\n",
    "        self.ambient = normal if self.ambient is None else self.ambient + (1 - 0.95 ** ease) * (normal - self.ambient)\n",
    "        contrast = max(cfg.contrast * s.span, 1e-6)\n",
    "        excess = np.clip(grid - self.ambient, 0, None)\n",
    "        age_fade = 0.15 + 0.85 * np.clip((np.arange(rows) - frac) / (rows - 2), 0, 1)[:, None]\n",
    "        strength = np.clip(excess / contrast, 0, 1) * age_fade\n",
    "        top = max(4 * contrast, float(excess.max()) * 1.1)\n",
    "        self.top = top if self.top is None else self.top + (1 - 0.8 ** ease) * (top - self.top)\n",
    "        self.place(self.cloud, frac, 0.0, self.top)\n",
    "\n",
    "        cells = np.flatnonzero(strength.ravel() > cfg.min_strength)\n",
    "        if not cells.size:\n",
    "            self.cloud.setData(pos=np.zeros((1, 3)), color=(0, 0, 0, 0), size=1)\n",
    "            return\n",
    "        row_order = (serial - (rows - 1) + np.arange(rows)) % rows\n",
    "        jit = self.jitter[:, :, row_order].reshape(self.PARTICLES, 3, -1)[:, :, cells]   # (P, 3, n)\n",
    "        heat, power = excess.ravel()[cells], strength.ravel()[cells]\n",
    "        pos = np.empty((self.PARTICLES * cells.size, 3), np.float32)\n",
    "        pos[:, 0] = (self.gx[cells] + jit[:, 0] * self.dx).ravel()\n",
    "        pos[:, 1] = (self.gy[cells] + jit[:, 1] * self.dy).ravel()\n",
    "        pos[:, 2] = (np.clip(heat + jit[:, 2] * contrast * 0.15, 0, None) * (self.SZ / self.top)).ravel()\n",
    "        power = np.tile(power, self.PARTICLES)\n",
    "        colors = LUT_RGBA[colour_index(self.ambient + np.tile(heat, self.PARTICLES), s.low, s.span)]\n",
    "        colors[:, 3] = power * 0.5                                            # soft additive glow\n",
    "        self.cloud.setData(pos=pos, color=colors, size=3 + 9 * power)\n",
    "\n",
    "\n",
    "# ==============================================================================================\n",
    "# 6. The window\n",
    "# ==============================================================================================\n",
    "\n",
    "STYLE = f\"\"\"\n",
    "QWidget#root {{ background: {BG}; }}\n",
    "QLabel {{ color: {TEXT}; }}\n",
    "QLabel[muted=\"true\"] {{ color: {MUTED}; }}\n",
    "QFrame[panel=\"true\"] {{ background: {PANEL}; border: 1px solid {EDGE}; border-radius: 4px; }}\n",
    "QListWidget {{ background: {PANEL}; border: 1px solid {EDGE}; color: {TEXT}; outline: 0; }}\n",
    "QListWidget::item {{ padding: 2px 4px; }}\n",
    "QPushButton {{ background: {PANEL}; color: {TEXT}; border: 1px solid {EDGE}; padding: 6px 10px; border-radius: 3px; }}\n",
    "QPushButton:hover {{ background: #232838; }}\n",
    "\"\"\"\n",
    "\n",
    "\n",
    "def make_label(text=\"\", muted=False, size=9, bold=False):\n",
    "    w = QtWidgets.QLabel(text)\n",
    "    w.setTextFormat(Qt.TextFormat.PlainText)            # plain text paints much faster than rich text\n",
    "    w.setProperty(\"muted\", muted)\n",
    "    font = w.font()\n",
    "    font.setPointSizeF(size)\n",
    "    font.setBold(bold)\n",
    "    w.setFont(font)\n",
    "    return w\n",
    "\n",
    "\n",
    "def set_text(widget, text, setter=None):\n",
    "    \"\"\"Change text only when it differs: every change makes Qt lay the window out again.\"\"\"\n",
    "    if getattr(widget, \"_shown\", None) != text:\n",
    "        widget._shown = text\n",
    "        (setter or widget.setText)(text)\n",
    "\n",
    "\n",
    "class FastImage(QtWidgets.QGraphicsItem):\n",
    "    \"\"\"Shows a BGRA image. That is Qt's native pixel format, so painting is a plain copy.\"\"\"\n",
    "\n",
    "    def __init__(self, w, h):\n",
    "        super().__init__()\n",
    "        self.rect = QtCore.QRectF(-0.5, -0.5, w, h)\n",
    "        self.pixels = self.qimage = None\n",
    "\n",
    "    def boundingRect(self):\n",
    "        return self.rect\n",
    "\n",
    "    def set_pixels(self, bgra):\n",
    "        self.pixels = np.ascontiguousarray(bgra)          # Qt reads straight from this buffer\n",
    "        self.qimage = pg.functions.ndarray_to_qimage(self.pixels, QtGui.QImage.Format.Format_ARGB32_Premultiplied)\n",
    "        self.update()\n",
    "\n",
    "    def paint(self, painter, *args):\n",
    "        if self.qimage is not None:\n",
    "            painter.drawImage(self.rect, self.qimage)\n",
    "\n",
    "\n",
    "class Window(QtWidgets.QWidget):\n",
    "    closed = False\n",
    "\n",
    "    def closeEvent(self, event):\n",
    "        self.closed = True\n",
    "        event.accept()\n",
    "\n",
    "\n",
    "class ThermalApp:\n",
    "    \"\"\"Live map with every hotspot boxed, a tracked-only view, both 3D views and data panels.\n",
    "\n",
    "    Pick a hotspot by clicking its box or its list row: the live map keeps showing everything,\n",
    "    while the tracked view, 3D views, data panel and chart follow only that hotspot.\n",
    "    \"\"\"\n",
    "\n",
    "    ROWS = 8                                            # hotspots shown in the list\n",
    "\n",
    "    def __init__(self, cfg, scale, history, tracker, detector, shape, simulated):\n",
    "        pg.setConfigOptions(antialias=False)\n",
    "        self.qapp = pg.mkQApp()\n",
    "        self.cfg, self.scale, self.history, self.tracker, self.detector = cfg, scale, history, tracker, detector\n",
    "        self.height, self.width = shape\n",
    "        self.selected = None                            # picked hotspot ID (None = all)\n",
    "        self.message, self.message_until = \"\", 0.0\n",
    "        self.row_ids, self.drawn = [], []\n",
    "        self.frames, self.fps, self.fps_t0 = 0, 0.0, time.monotonic()\n",
    "        self.soft_key = self.soft = None                # cached soft mask of the picked hotspot\n",
    "        self.last_3d, self.last_panels, self.panel_step = time.monotonic(), -np.inf, 0\n",
    "        m = max(0, int(cfg.focus_margin))\n",
    "        self.kernel = cv.getStructuringElement(cv.MORPH_ELLIPSE, (2 * m + 1, 2 * m + 1))\n",
    "\n",
    "        win = self.window = Window()\n",
    "        win.setObjectName(\"root\")\n",
    "        win.setWindowTitle(\"Thermal hotspot tracker\")\n",
    "        win.setStyleSheet(STYLE)\n",
    "        win.resize(*cfg.window_size)\n",
    "        outer = QtWidgets.QVBoxLayout(win)\n",
    "        outer.setContentsMargins(12, 8, 12, 10)\n",
    "        outer.addWidget(make_label(\"Thermal hotspot tracker\" + (\"   ·   SIMULATION\" if simulated else \"\"),\n",
    "                                   size=14, bold=True))\n",
    "        outer.addWidget(make_label(\"Click a box (or a list row) to track one hotspot   ·   N / P  next / previous\"\n",
    "                                   \"   ·   A  show all   ·   1-8  pick from list   ·   S  save CSV   ·   Q  quit\"\n",
    "                                   \"   ·   drag the 3D views to rotate them\", muted=True))\n",
    "        body = QtWidgets.QHBoxLayout()\n",
    "        left, right = QtWidgets.QVBoxLayout(), QtWidgets.QVBoxLayout()\n",
    "        body.addLayout(left, 7)\n",
    "        body.addLayout(right, 3)\n",
    "        outer.addLayout(body, 1)\n",
    "        self._build_maps(left)\n",
    "        self._build_3d(left)\n",
    "        self._build_side(right)\n",
    "        self._bind_keys()\n",
    "        win.show()\n",
    "        self.pump()\n",
    "\n",
    "    # ---- building the window ----\n",
    "\n",
    "    def _build_maps(self, layout):\n",
    "        \"\"\"Live map and tracked-only view, side by side, sharing one colour bar.\"\"\"\n",
    "        self.maps = pg.GraphicsLayoutWidget()\n",
    "        self.maps.setBackground(BG)\n",
    "        self.live_plot, self.live_img, self.live_peak = self._map_plot()\n",
    "        self.focus_plot, self.focus_img, self.focus_peak = self._map_plot()\n",
    "        self.cbar = pg.ColorBarItem(values=(self.scale.low, self.scale.high), colorMap=INFERNO,\n",
    "                                    interactive=False, width=12, label=self.scale.label)\n",
    "        self.maps.addItem(self.cbar)\n",
    "        self.live_boxes, self.focus_boxes = [], []\n",
    "        self.focus_note = pg.TextItem(\"\", color=TEXT, anchor=(0.5, 0.5), fill=pg.mkBrush(BG), border=pg.mkPen(EDGE))\n",
    "        self.focus_note.setPos(self.width / 2, self.height / 2)\n",
    "        self.focus_plot.addItem(self.focus_note)\n",
    "        self.maps.scene().sigMouseClicked.connect(self._on_map_click)\n",
    "        layout.addWidget(self.maps, 11)\n",
    "\n",
    "    def _map_plot(self):\n",
    "        p = self.maps.addPlot()\n",
    "        p.hideAxis(\"left\")\n",
    "        p.hideAxis(\"bottom\")\n",
    "        p.setMenuEnabled(False)\n",
    "        p.hideButtons()\n",
    "        vb = p.getViewBox()\n",
    "        vb.setMouseEnabled(False, False)\n",
    "        vb.invertY(True)\n",
    "        vb.setAspectLocked(True)\n",
    "        vb.setRange(xRange=(-0.5, self.width - 0.5), yRange=(-0.5, self.height - 0.5), padding=0)\n",
    "        vb.setBorder(pg.mkPen(EDGE))\n",
    "        image = FastImage(self.width, self.height)\n",
    "        p.addItem(image)\n",
    "        peak = pg.ScatterPlotItem(symbol=\"+\", size=16, pen=pg.mkPen(\"w\", width=1.6), brush=None)\n",
    "        peak.setZValue(10)\n",
    "        p.addItem(peak)\n",
    "        return p, image, peak\n",
    "\n",
    "    def _build_3d(self, layout):\n",
    "        forget_gl_shaders()                             # in case an earlier run left some behind\n",
    "        self.views = [Surface3D(self.history, self.cfg, self.scale), Wisps3D(self.history, self.cfg, self.scale)]\n",
    "        self.view_titles = [make_label(size=10) for _ in self.views]\n",
    "        row = QtWidgets.QHBoxLayout()\n",
    "        for view, title in zip(self.views, self.view_titles):\n",
    "            col = QtWidgets.QVBoxLayout()\n",
    "            col.addWidget(title)\n",
    "            col.addWidget(view.widget, 1)\n",
    "            row.addLayout(col)\n",
    "        layout.addLayout(row, 10)\n",
    "\n",
    "    def _build_side(self, layout):\n",
    "        # hotspot list\n",
    "        self.list_title = make_label(muted=True, bold=True)\n",
    "        self.list = QtWidgets.QListWidget()\n",
    "        self.list.setFocusPolicy(Qt.FocusPolicy.NoFocus)\n",
    "        self.list.setSelectionMode(QtWidgets.QAbstractItemView.SelectionMode.NoSelection)\n",
    "        self.list.setVerticalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)\n",
    "        self.list.setFont(QtGui.QFont(\"Consolas\", 10))\n",
    "        self.list.setFixedHeight(self.ROWS * 22 + 8)\n",
    "        for _ in range(self.ROWS):\n",
    "            self.list.addItem(\"\")\n",
    "        self.list.itemClicked.connect(lambda item: self._pick_row(self.list.row(item)))\n",
    "        layout.addWidget(self.list_title)\n",
    "        layout.addWidget(self.list)\n",
    "\n",
    "        # data panel: names on the left, values on the right\n",
    "        info = QtWidgets.QFrame()\n",
    "        info.setProperty(\"panel\", True)\n",
    "        box = QtWidgets.QVBoxLayout(info)\n",
    "        box.setContentsMargins(10, 8, 10, 8)\n",
    "        self.info_title = make_label(bold=True)\n",
    "        self.info_title_color = QtCore.QObject()          # just remembers the title's current colour\n",
    "        self.info_keys, self.info_vals = make_label(size=9.5, muted=True), make_label(size=9.5)\n",
    "        cols = QtWidgets.QHBoxLayout()\n",
    "        for w in (self.info_keys, self.info_vals):\n",
    "            w.setAlignment(Qt.AlignmentFlag.AlignTop | Qt.AlignmentFlag.AlignLeft)\n",
    "            cols.addWidget(w)\n",
    "        self.info_keys.setFixedWidth(120)\n",
    "        cols.setStretch(1, 1)\n",
    "        box.addWidget(self.info_title)\n",
    "        box.addLayout(cols, 1)\n",
    "        layout.addWidget(info, 5)\n",
    "\n",
    "        # temperature chart\n",
    "        self.chart_title = make_label(muted=True, size=8.5)\n",
    "        self.chart = pg.PlotWidget(background=PANEL)\n",
    "        pi = self.chart.getPlotItem()\n",
    "        pi.showGrid(x=True, y=True, alpha=0.25)\n",
    "        pi.setMenuEnabled(False)\n",
    "        pi.hideButtons()\n",
    "        pi.setMouseEnabled(False, False)\n",
    "        pi.setXRange(-self.cfg.chart_seconds, 0, padding=0)\n",
    "        for axis, text in ((\"bottom\", \"seconds ago\"), (\"left\", self.scale.label)):\n",
    "            pi.setLabel(axis, text, color=MUTED)\n",
    "            pi.getAxis(axis).setTextPen(MUTED)\n",
    "            pi.getAxis(axis).setPen(EDGE)\n",
    "        self.chart_lines = []\n",
    "        self.mean_line = pi.plot(pen=pg.mkPen(MUTED, width=1, style=Qt.PenStyle.DashLine))\n",
    "        self.peak_line = pg.InfiniteLine(angle=0, pen=pg.mkPen(MUTED, width=1, style=Qt.PenStyle.DotLine))\n",
    "        pi.addItem(self.peak_line)\n",
    "        layout.addWidget(self.chart_title)\n",
    "        layout.addWidget(self.chart, 4)\n",
    "\n",
    "        # status line and buttons\n",
    "        self.message_label = make_label()\n",
    "        self.message_label.setStyleSheet(\"color: #ffd166;\")\n",
    "        layout.addWidget(self.message_label)\n",
    "        buttons = QtWidgets.QHBoxLayout()\n",
    "        for text, action in ((\"◀ Prev\", lambda: self.cycle(-1)), (\"Next ▶\", lambda: self.cycle(1)),\n",
    "                             (\"Show all\", lambda: self.select(None)), (\"Save CSV\", self.save_csv)):\n",
    "            button = QtWidgets.QPushButton(text)\n",
    "            button.setFocusPolicy(Qt.FocusPolicy.NoFocus)\n",
    "            button.clicked.connect(lambda _=False, act=action: act())\n",
    "            buttons.addWidget(button)\n",
    "        layout.addLayout(buttons)\n",
    "\n",
    "    def _bind_keys(self):\n",
    "        keys = {\"Q\": self.window.close, \"Escape\": self.window.close, \"S\": self.save_csv,\n",
    "                \"A\": lambda: self.select(None), \"0\": lambda: self.select(None)}\n",
    "        keys.update({k: lambda: self.cycle(1) for k in (\"N\", \"Right\", \"Down\")})\n",
    "        keys.update({k: lambda: self.cycle(-1) for k in (\"P\", \"Left\", \"Up\")})\n",
    "        keys.update({str(i + 1): lambda i=i: self._pick_row(i) for i in range(self.ROWS)})\n",
    "        self.shortcuts = []\n",
    "        for key, action in keys.items():\n",
    "            shortcut = QShortcut(QtGui.QKeySequence(key), self.window)\n",
    "            shortcut.setContext(Qt.ShortcutContext.ApplicationShortcut)\n",
    "            shortcut.activated.connect(action)\n",
    "            self.shortcuts.append(shortcut)                 # shortcuts stop working if not kept\n",
    "\n",
    "    # ---- picking a hotspot ----\n",
    "\n",
    "    @property\n",
    "    def closed(self):\n",
    "        return self.window.closed\n",
    "\n",
    "    def pump(self):\n",
    "        \"\"\"Let Qt paint and handle clicks/keys.\"\"\"\n",
    "        self.qapp.processEvents()\n",
    "\n",
    "    def select(self, tid):\n",
    "        if tid != self.selected:\n",
    "            self.selected = tid\n",
    "            self.history.reset()                        # 3D views restart with only this hotspot\n",
    "            self.soft_key, self.last_panels, self.panel_step = None, -np.inf, 0\n",
    "            self.flash(f\"Tracking hotspot #{tid} only\" if tid is not None else \"Showing all hotspots\")\n",
    "\n",
    "    def cycle(self, step):\n",
    "        ids = [t.id for t in self.tracker.listed()]\n",
    "        if not ids:\n",
    "            self.flash(\"No hotspots to pick\")\n",
    "        elif self.selected in ids:\n",
    "            self.select(ids[(ids.index(self.selected) + step) % len(ids)])\n",
    "        else:\n",
    "            self.select(ids[0] if step > 0 else ids[-1])\n",
    "\n",
    "    def _pick_row(self, row):\n",
    "        if 0 <= row < len(self.row_ids):\n",
    "            self.select(self.row_ids[row])\n",
    "\n",
    "    def _on_map_click(self, event):\n",
    "        vb = self.live_plot.vb\n",
    "        if event.button() != Qt.MouseButton.LeftButton or not vb.sceneBoundingRect().contains(event.scenePos()):\n",
    "            return\n",
    "        p = vb.mapSceneToView(event.scenePos())\n",
    "        pad = 3\n",
    "        hits = [t for t in self.drawn\n",
    "                if t.det.box[0] - pad <= p.x() <= t.det.box[0] + t.det.box[2] + pad\n",
    "                and t.det.box[1] - pad <= p.y() <= t.det.box[1] + t.det.box[3] + pad]\n",
    "        if hits:\n",
    "            self.select(min(hits, key=lambda t: t.det.area).id)\n",
    "        else:\n",
    "            self.flash(\"No hotspot there - click inside a box\")\n",
    "\n",
    "    def flash(self, text, seconds=3.0):\n",
    "        self.message, self.message_until = text, time.monotonic() + seconds\n",
    "\n",
    "    def save_csv(self):\n",
    "        t = self.tracker.get(self.selected)\n",
    "        if t is None:\n",
    "            return self.flash(\"Pick a hotspot first, then save its data\")\n",
    "        name = f\"hotspot_{t.id}_{time.strftime('%Y%m%d_%H%M%S')}.csv\"\n",
    "        data = np.array(t.log, np.float64)\n",
    "        data[:, 0] -= t.first_seen\n",
    "        np.savetxt(name, data, delimiter=\",\", fmt=\"%.3f\", comments=\"\",\n",
    "                   header=\"time_s,temp_max,temp_mean,center_x,center_y,box_x,box_y,box_w,box_h\")\n",
    "        print(f\"Saved {len(data)} samples of hotspot #{t.id} to {name}\")\n",
    "        self.flash(f\"Saved {name}\")\n",
    "\n",
    "    # ---- every frame ----\n",
    "\n",
    "    def focus_values(self, values):\n",
    "        \"\"\"The frame with everything except the picked hotspot flattened to the scene median.\"\"\"\n",
    "        if self.selected is None:\n",
    "            return values\n",
    "        ambient, t = self.detector.ambient, self.tracker.get(self.selected)\n",
    "        if t is None:\n",
    "            return np.full_like(values, ambient)\n",
    "        if self.soft_key != (t.id, t.hits):             # rebuild the soft mask only when it changed\n",
    "            grown = cv.dilate(t.det.mask.astype(np.uint8), self.kernel).astype(np.float32)\n",
    "            self.soft, self.soft_key = cv.GaussianBlur(grown, (0, 0), 1.5), (t.id, t.hits)\n",
    "        return (ambient + (values - ambient) * self.soft).astype(np.float32)\n",
    "\n",
    "    def draw(self, values, focused, now, frac, draw_3d=True, draw_panel=True):\n",
    "        \"\"\"Update the window for this frame (Qt paints it on the next pump()).\n",
    "\n",
    "        frac: how far (0..1) the 3D views are into the current row.\n",
    "        draw_3d / draw_panel: lets run() spread the expensive parts over different frames.\n",
    "        \"\"\"\n",
    "        self.frames += 1\n",
    "        if now - self.fps_t0 >= 1.0:\n",
    "            self.fps, self.frames, self.fps_t0 = self.frames / (now - self.fps_t0), 0, now\n",
    "\n",
    "        s, size = self.scale, (2 * self.width, 2 * self.height)\n",
    "        for image, data in ((self.live_img, values), (self.focus_img, focused)):\n",
    "            image.set_pixels(cv.resize(LUT_BGRA[colour_index(data, s.low, s.span)], size, interpolation=cv.INTER_LINEAR))\n",
    "        listed, picked = self.tracker.listed(), self.tracker.get(self.selected)\n",
    "        self._draw_maps(listed, picked)\n",
    "        set_text(self.message_label, self.message if time.monotonic() < self.message_until else \"\")\n",
    "\n",
    "        if draw_3d and self.history.rows:\n",
    "            ease = min((now - self.last_3d) / self.cfg.update_seconds, 4.0)\n",
    "            self.last_3d = now\n",
    "            grid = cv.GaussianBlur(self.history.with_live_row(), (0, 0), sigmaX=self.cfg.blur_x, sigmaY=self.cfg.blur_t)\n",
    "            for view in self.views:\n",
    "                view.draw(grid, frac, self.history.serial, ease)\n",
    "\n",
    "        # Side panels: one piece per frame, every panel_seconds.\n",
    "        if draw_panel and (self.panel_step or now - self.last_panels >= self.cfg.panel_seconds):\n",
    "            if self.panel_step == 0:\n",
    "                self.last_panels = now\n",
    "            (self._draw_list, self._draw_info, self._draw_chart, self._draw_titles)[self.panel_step](listed, picked, now)\n",
    "            self.panel_step = (self.panel_step + 1) % 4\n",
    "\n",
    "    def _draw_maps(self, listed, picked):\n",
    "        shown = self.drawn = [t for t in listed if t.missed <= 2]\n",
    "        for i, t in enumerate(shown):\n",
    "            if picked is None:\n",
    "                self._place_box(self.live_plot, self.live_boxes, i, t, 1.4, False, 1.0)\n",
    "            elif t is picked:\n",
    "                self._place_box(self.live_plot, self.live_boxes, i, t, 2.6, False, 1.0)\n",
    "            else:\n",
    "                self._place_box(self.live_plot, self.live_boxes, i, t, 1.0, True, 0.45)\n",
    "        self._hide_boxes(self.live_boxes, len(shown))\n",
    "        n = len(shown)\n",
    "        self._title(self.live_plot, f\"LIVE MAP  ·  {n} hotspot{'s' if n != 1 else ''}  ·  click a box to track it\"\n",
    "                                    f\"  ·  {self.fps:.0f} fps\")\n",
    "\n",
    "        if picked is not None:\n",
    "            self._place_box(self.focus_plot, self.focus_boxes, 0, picked, 2.6, picked.missed != 0, 1.0)\n",
    "            peak = [picked.det.peak_xy[0]], [picked.det.peak_xy[1]]\n",
    "            self.focus_note.setVisible(False)\n",
    "            title = f\"TRACKED ONLY  ·  hotspot #{picked.id}\"\n",
    "        else:\n",
    "            self._hide_boxes(self.focus_boxes)\n",
    "            peak = [], []\n",
    "            gone = self.selected is not None\n",
    "            set_text(self.focus_note, f\"Hotspot #{self.selected} is gone\\npick another one\" if gone\n",
    "                     else \"Nothing picked: showing every hotspot\\nclick a box on the live map\")\n",
    "            self.focus_note.setVisible(gone or not shown)\n",
    "            title = \"TRACKED ONLY  ·  \" + (f\"#{self.selected} (gone)\" if gone else \"all hotspots\")\n",
    "        for marker in (self.live_peak, self.focus_peak):\n",
    "            marker.setData(*peak)\n",
    "        self._title(self.focus_plot, title)\n",
    "\n",
    "    def _place_box(self, plot, pool, i, t, width, dashed, alpha):\n",
    "        \"\"\"Box + label number i of `pool` around hotspot t (boxes are reused, never deleted).\"\"\"\n",
    "        while len(pool) <= i:\n",
    "            rect = QtWidgets.QGraphicsRectItem()\n",
    "            rect.setBrush(QtGui.QBrush(Qt.BrushStyle.NoBrush))\n",
    "            label = pg.TextItem(\"\", fill=pg.mkBrush(0, 0, 0, 150))\n",
    "            font = QtGui.QFont(\"Segoe UI\", 8)\n",
    "            font.setBold(True)\n",
    "            label.setFont(font)\n",
    "            for z, item in ((5, rect), (6, label)):\n",
    "                item.setZValue(z)\n",
    "                plot.addItem(item)\n",
    "            pool.append([rect, label, None])\n",
    "        rect, label, style = pool[i]\n",
    "        if style != (t.id, width, dashed, alpha):       # restyle only when the look changes\n",
    "            color = spot_color(t.id)\n",
    "            rect.setPen(pg.mkPen(color, width=width, style=Qt.PenStyle.DashLine if dashed else Qt.PenStyle.SolidLine))\n",
    "            label.setColor(color)\n",
    "            rect.setOpacity(alpha)\n",
    "            label.setOpacity(alpha)\n",
    "            pool[i][2] = (t.id, width, dashed, alpha)\n",
    "        x, y, w, h = t.det.box\n",
    "        rect.setRect(x - 0.5, y - 0.5, w, h)\n",
    "        above, right = y > 14, x > self.width - 60      # keep the label inside the image\n",
    "        label.setAnchor((1 if right else 0, 1 if above else 0))\n",
    "        label.setPos(x + w - 0.5 if right else x - 0.5, y - 1.5 if above else y + h + 0.5)\n",
    "        set_text(label, f\"#{t.id}  {t.det.peak:.1f} {self.scale.label}\")\n",
    "        rect.setVisible(True)\n",
    "        label.setVisible(True)\n",
    "\n",
    "    @staticmethod\n",
    "    def _hide_boxes(pool, start=0):\n",
    "        for rect, label, _ in pool[start:]:\n",
    "            rect.setVisible(False)\n",
    "            label.setVisible(False)\n",
    "\n",
    "    @staticmethod\n",
    "    def _title(plot, text):\n",
    "        set_text(plot, text, lambda s: plot.setTitle(s, color=TEXT, size=\"10pt\", justify=\"left\"))\n",
    "\n",
    "    # ---- side panels (a few times a second) ----\n",
    "\n",
    "    def _draw_list(self, listed, picked, now):\n",
    "        rows = listed[:self.ROWS]\n",
    "        self.row_ids = [t.id for t in rows]\n",
    "        more = len(listed) - len(rows)\n",
    "        set_text(self.list_title, f\"HOTSPOTS  ·  {len(listed)}\" + (f\"  (+{more} not shown)\" if more else \"\")\n",
    "                 + (\"\" if rows else \"   ·   none right now\"))\n",
    "        for i in range(self.ROWS):\n",
    "            item = self.list.item(i)\n",
    "            item.setHidden(i >= len(rows))\n",
    "            if i >= len(rows):\n",
    "                continue\n",
    "            t = rows[i]\n",
    "            color = QtGui.QColor(spot_color(t.id))\n",
    "            color.setAlphaF(0.45 if picked is not None and t is not picked else 1.0)\n",
    "            status = \"live\" if t.missed == 0 else f\"missing {now - t.last_seen:.0f}s\"\n",
    "            item.setText(f\"■ #{t.id:<3d}{t.det.peak:6.1f} {self.scale.label}   peak {t.high:5.1f}   {status}\")\n",
    "            item.setForeground(color)\n",
    "            item.setBackground(QtGui.QColor(\"#22314a\") if t is picked else QtGui.QColor(0, 0, 0, 0))\n",
    "\n",
    "    def _draw_info(self, listed, picked, now):\n",
    "        u, s = self.scale.label, self.scale\n",
    "        if picked is not None:\n",
    "            t, d = picked, picked.det\n",
    "            ago = now - t.last_seen\n",
    "            status = (\"tracking\" if t.missed == 0 else f\"searching... {ago:.1f} s\"\n",
    "                      if t.missed <= self.cfg.forget_frames else f\"lost, last seen {ago:.0f} s ago\")\n",
    "            cx, cy = t.center\n",
    "            rows = [(\"Hotspot\", f\"#{t.id}\"), (\"Status\", status),\n",
    "                    (\"Temp now\", f\"{d.peak:.1f} {u}\" + (\"\" if t.missed == 0 else \"  (last seen)\")),\n",
    "                    (\"Region mean\", f\"{d.mean:.1f} {u}\"), (\"Recorded peak\", f\"{t.high:.1f} {u}\"),\n",
    "                    (\"Recorded low\", f\"{t.low:.1f} {u}\"), (\"Recorded avg\", f\"{t.average:.1f} {u}\"),\n",
    "                    (\"Recorded for\", f\"{t.last_seen - t.first_seen:.1f} s  ({t.hits} samples)\"),\n",
    "                    (\"Position\", f\"x {cx:.0f}, y {cy:.0f} px\"),\n",
    "                    (\"Box size\", f\"{d.box[2]} x {d.box[3]} px  ({d.area} px)\"),\n",
    "                    (\"Distance moved\", f\"{t.distance:.0f} px\"),\n",
    "                    (\"From start\", f\"{np.hypot(cx - t.start[0], cy - t.start[1]):.0f} px\"),\n",
    "                    (\"Speed\", f\"{t.speed():.1f} px/s\")]\n",
    "            title, color = f\"PICKED HOTSPOT  #{t.id}\", spot_color(t.id)\n",
    "        else:\n",
    "            live = [t for t in listed if t.missed == 0]\n",
    "            hot = max(live, key=lambda t: t.det.peak, default=None)\n",
    "            rows = [(\"Tracking\", \"all hotspots\" if self.selected is None else f\"#{self.selected} (gone)\"),\n",
    "                    (\"Hotspots now\", str(len(live))),\n",
    "                    (\"Hottest\", f\"#{hot.id}   {hot.det.peak:.1f} {u}\" if hot else \"-\"),\n",
    "                    (\"Scene median\", f\"{self.detector.ambient:.1f} {u}\"),\n",
    "                    (\"Hotspot above\", f\"{self.detector.threshold:.1f} {u}\"),\n",
    "                    (\"Colour scale\", f\"{s.low:.1f} to {s.high:.1f} {u}\"),\n",
    "                    (\"Frame rate\", f\"{self.fps:.1f} fps\"), (\"\", \"\"),\n",
    "                    (\"Tip\", \"click a box or a list row\"), (\"\", \"to track a single hotspot\")]\n",
    "            title, color = \"OVERVIEW\", MUTED\n",
    "        set_text(self.info_title, title)\n",
    "        set_text(self.info_title_color, color, lambda c: self.info_title.setStyleSheet(f\"color: {c};\"))\n",
    "        set_text(self.info_keys, \"\\n\".join(k for k, _ in rows))\n",
    "        set_text(self.info_vals, \"\\n\".join(v for _, v in rows))\n",
    "\n",
    "    def _draw_chart(self, listed, picked, now):\n",
    "        pi = self.chart.getPlotItem()\n",
    "        tracks = [picked] if picked is not None else [t for t in listed if t.missed <= self.cfg.forget_frames][:8]\n",
    "        while len(self.chart_lines) < len(tracks):\n",
    "            self.chart_lines.append(pi.plot())\n",
    "        lo, hi = np.inf, -np.inf\n",
    "        for line, t in zip(self.chart_lines, tracks):\n",
    "            data = np.array([e[:3] for e in t.recent(now - self.cfg.chart_seconds)]).reshape(-1, 3)\n",
    "            line.setData(data[:, 0] - now, data[:, 1])\n",
    "            line.setPen(pg.mkPen(spot_color(t.id), width=2.0 if picked is not None else 1.3))\n",
    "            line.setVisible(True)\n",
    "            if len(data):\n",
    "                lo, hi = min(lo, data[:, 1:].min()), max(hi, data[:, 1].max())\n",
    "            if t is picked:\n",
    "                self.mean_line.setData(data[:, 0] - now, data[:, 2])\n",
    "                self.peak_line.setValue(t.high)\n",
    "                hi = max(hi, t.high)\n",
    "        for line in self.chart_lines[len(tracks):]:\n",
    "            line.setVisible(False)\n",
    "        self.mean_line.setVisible(picked is not None)\n",
    "        self.peak_line.setVisible(picked is not None)\n",
    "        if not np.isfinite(lo):\n",
    "            lo, hi = self.scale.low, self.scale.high\n",
    "        pad = max(0.5, 0.08 * (hi - lo))\n",
    "        pi.setYRange(lo - pad, hi + pad, padding=0)\n",
    "        set_text(self.chart_title, f\"TEMPERATURE  #{picked.id}   (solid max, dashed mean, dotted recorded peak)\"\n",
    "                 if picked is not None else \"TEMPERATURE  ·  all hotspots (max)\")\n",
    "\n",
    "    def _draw_titles(self, listed, picked, now):\n",
    "        self.cbar.setLevels((self.scale.low, self.scale.high))\n",
    "        what = f\"hotspot #{self.selected}\" if self.selected is not None else \"all hotspots\"\n",
    "        for name, view, title in zip((\"3D map\", \"Wisps\"), self.views, self.view_titles):\n",
    "            set_text(title, f\"{name}  ·  {what}  ·  {view.range_text}\")\n",
    "\n",
    "\n",
    "# ==============================================================================================\n",
    "# 7. Main loop\n",
    "# ==============================================================================================\n",
    "\n",
    "def run(cfg=Config()):\n",
    "    camera = SimulatedCamera(cfg) if cfg.simulate else Camera(cfg)\n",
    "    pacer = FramePacer(cfg.sim_fps) if cfg.simulate else None\n",
    "    detector, tracker = HotspotDetector(cfg), Tracker(cfg)\n",
    "    if pacer:\n",
    "        how = f\"locked to the {1 / pacer.refresh:.0f} Hz screen\" if pacer.refresh else \"timer\"\n",
    "        print(f\"SIMULATION at {pacer.fps:.0f} fps ({how}). Set Config.simulate=False for the real camera.\")\n",
    "    else:\n",
    "        print(\"Reading temperatures (°C).\" if camera.raw else \"Reading brightness only: this camera sends processed frames.\")\n"
    "\n",
    "    def next_frame():\n",
    "        \"\"\"Read and analyse a frame. Runs on a helper thread, overlapping the previous frame's painting.\"\"\"\n",
    "        values = camera.read()\n",
    "        if values is None:\n",
    "            return None\n",
    "        camera.scale.update(values)\n",
    "        return values, detector.detect(values, camera.scale), time.monotonic()\n",
    "\n",
    "    # Above ~40 fps the 3D views redraw every other frame and the side panels use the frames in\n",
    "    # between, so no single frame does everything and misses its screen refresh.\n",
    "    split = pacer is not None and pacer.fps > 40\n",
    "    # Python runs one thread at a time and by default swaps every 5 ms, so the drawing thread\n",
    "    # could wait 5 ms for its turn after a screen refresh. Swap every 0.5 ms while we run.\n",
    "    old_switch = sys.getswitchinterval()\n",
    "    sys.setswitchinterval(0.0005)\n",
    "    worker = ThreadPoolExecutor(max_workers=1)\n",
    "    job = worker.submit(next_frame)\n",
    "    app = history = None\n",
    "    last_row, frame_no = -np.inf, 0\n",
    "    try:\n",
    "        while True:\n",
    "            while app is not None and not job.done() and not app.closed:   # real camera: stay responsive\n",
    "                app.pump()\n",
    "                time.sleep(0.002)\n",
    "            frame = job.result()\n",
    "            if frame is None:\n",
    "                break\n",
    "            job = worker.submit(next_frame)             # start the next frame right away\n",
    "            values, found, now = frame\n",
    "            tracker.update(found, now, keep=app.selected if app else None)\n",
    "\n",
    "            if app is None:\n",
    "                history = History(values.shape[1], cfg)\n",
    "                app = ThermalApp(cfg, camera.scale, history, tracker, detector, values.shape, cfg.simulate)\n",
    "\n",
    "            focused = app.focus_values(values)\n",
    "            history.add_frame(focused)\n",
    "            if now - last_row >= cfg.update_seconds:\n",
    "                last_row = max(last_row + cfg.update_seconds, now - 0.5 * cfg.update_seconds)  # steady rhythm\n",
    "                history.commit()\n",
    "            frac = min(max((now - last_row) / cfg.update_seconds, 0.0), 1.0)\n",
    "\n",
    "            frame_no += 1\n",
    "            draw_3d = not split or frame_no % 2 == 0\n",
    "            app.draw(values, focused, now, frac, draw_3d=draw_3d, draw_panel=not split or not draw_3d)\n",
    "            if pacer:\n",
    "                pacer.wait()                            # paint right after a screen refresh\n",
    "            app.pump()\n",
    "            if app.closed:\n",
    "                break\n",
    "    finally:\n",
    "        worker.shutdown(wait=True, cancel_futures=True)\n",
    "        sys.setswitchinterval(old_switch)\n",
    "        camera.release()\n",
    "        if pacer:\n",
    "            print(pacer.report())\n",
    "        if app is not None:\n",
    "            app.window.close()\n",
    "            app.window.deleteLater()\n",
    "            app.pump()\n",
    "\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    run()\n",
    "    "
   ]
